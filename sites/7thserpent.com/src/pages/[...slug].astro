---
/**
 * Маршрут страниц дерева `7thserpent.com` (пачка 0, П85 п. 1). Форма —
 * маршрута первого сайта (`sites/ac4bf-thewatch.com/src/pages/[...slug].astro`),
 * написанная заново в LF для этого сайта; вынос в ядро — позже.
 *
 * АДРЕС — ИЗ ФАЙЛА СОДЕРЖАНИЯ, ПРАВДА — ИЗ СТРУКТУРЫ. Поле `url` файла
 * `src/content/tresc/*.md` проходит `getPage` при сборке: адрес мимо
 * `structure.json` прерывает сборку (П24 п. 1). `title`, `description` и `h1`
 * — из структуры (П24 п. 3), набор и порядок секций — из `blocks[]`; из файла
 * содержания приходят только слова.
 *
 * ГЛАВНАЯ ЗДЕСЬ НЕ ЖИВЁТ: у неё свой шаблон (`index.astro`, как у первого
 * сайта, П32 п. 4) и свой эталон. Файл содержания с адресом `/` — отказ.
 *
 * ЧТО МАРШРУТ ПЕЧАТАЕТ. Три ветви — `story-row` (с вхождениями по роли;
 * ряд с кадром или без), `link-list` и `cta-band`. Пачка 0: `story-row`
 * без кадра и `link-list`, стенд — `/404/` (П85 п. 6); вхождения по роли
 * на нём не стоят и держатся положительной пробой P2 `tools/proby-tresci.mjs`.
 * Пачка 1 (П89): `cta-band` — первая страница формы `/pc/`, кадр ряда —
 * `/media/` (ответ владельца 2 в П89); ветвь без страницы и без пробы
 * не пишется. Условие `gotowy` в списке печати держит форму первого сайта:
 * все три блока маршрута в ядре есть, и пробой его не достать без правки
 * словаря ядра. Остальные блоки дерева, которые ядро умеет
 * (`hero-key-art`, `byline`, `gallery`), приходят ветвью вместе
 * с первой страницей своей формы — со стопом на глаза владельца (план P4
 * в докладе сессии 12). Страница, объявившая такой блок, не собирается,
 * и отказ говорит именно это — «ветви нет», а не «нет содержания».
 *
 * БЛОК, КОТОРОГО НЕТ В ЯДРЕ, ПРОПУСКАЕТСЯ ГРОМКО. Готовность — поле
 * `реализован` в `core/structure/blocks.json`, а не список в этом файле.
 * Каждый пропущенный блок печатается по имени при сборке: `video` (П71 п. 3)
 * реализуется с первой страницей с видео (П85, «вне объёма»). Тихая заглушка
 * запрещена: страница с пропуском выглядит так же, как страница без него.
 *
 * ПОРЯДОК ПРОВЕРОК ниже — от частного отказа к общему: каждая проба
 * `tools/proby-tresci.mjs` упирается в свою проверку и получает её отказ
 * (имя проверки — в поле `sudya` пробы, в тексте отказа — его причина),
 * а общая сверка «`blocks[]` и печать разошлись» остаётся последним рубежом.
 * Предел порядка («судью судят», раунды 1–2, R1-MARSHRUT-10, R2-MARSHRUT-5):
 * поле блока без ветви (`byline:`) отвергает раньше схема; любое вхождение
 * с ролью у блока вне `ROLE_UMIE` (`video#x`, `gallery#x`) — проверка ролей,
 * и её совет «научите маршрут роли» у блока без ветви неточен; повтор `id`
 * ряда — сторож якорей ядра после сборки. Отказ громкий, но называет
 * не «ветви нет».
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getPage } from '../lib/structure';
import { kadr } from '../data/media';
import slownik from '@factory/core/structure/blocks.json';
import StoryRow from '@factory/core/blocks/StoryRow.astro';
import LinkList from '@factory/core/blocks/LinkList.astro';
import CtaBand from '@factory/core/blocks/CtaBand.astro';
import SmartImage from '@factory/core/media/SmartImage.astro';

export async function getStaticPaths() {
  const wpisy = await getCollection('tresc');
  // Два файла на один адрес дали бы Astro два пути с одним `slug`: отказ
  // пришёл бы от сборщика (или не пришёл бы вовсе), а не от договора.
  const poAdresu = new Map<string, string[]>();
  for (const wpis of wpisy) poAdresu.set(wpis.data.url, [...(poAdresu.get(wpis.data.url) ?? []), wpis.id]);
  const dvazhdy = [...poAdresu].filter(([, ids]) => ids.length > 1);
  if (dvazhdy.length) {
    throw new Error(
      'Два файла содержания на один адрес:\n' +
        dvazhdy.map(([url, ids]) => `  ${url}: ${ids.join(', ')}`).join('\n') +
        '\nАдрес страницы — один файл; второй уберите.'
    );
  }
  return wpisy.map((wpis) => {
    const strona = getPage(wpis.data.url); // сторож: адрес мимо структуры прерывает сборку
    if (strona.url === '/') {
      throw new Error(
        `Файл содержания ${wpis.id} с адресом «/»: главная — свой шаблон (src/pages/index.astro) и свой эталон, маршрут её не печатает.`
      );
    }
    // Тело файла под фронтматтером маршрут не печатает — слова живут только
    // в полях; абзац под `---` пропал бы молча (раунд 1, R1-MARSHRUT-2).
    if (wpis.body?.trim()) {
      throw new Error(
        `Текст под фронтматтером в ${wpis.id}: тело файла содержания маршрут не печатает — слова только в полях (rows, related). Перенесите текст в поле или уберите.`
      );
    }
    return {
      params: { slug: wpis.data.url.replace(/^\/|\/$/g, '') },
      props: { wpis },
    };
  });
}

const { wpis } = Astro.props;
const strona = getPage(wpis.data.url);
const dane = wpis.data;

const gotowy = (imie: string) =>
  Boolean((slownik as { блоки: Record<string, { реализован?: boolean }> }).блоки[imie]?.реализован);

/**
 * ВХОЖДЕНИЕ, А НЕ ИМЯ. `blocks[]` может назвать блок дважды, если вхождения
 * различает `role` (`story-row` и `story-row#mobile` на `/max-payne-1/`).
 * Ключ `имя#роль` — единственная личность блока на странице.
 */
const klucz = (b: { block: string; role?: string }) => (b.role ? `${b.block}#${b.role}` : b.block);
const wystapienia = strona.blocks as { block: string; role?: string }[];

// Одно вхождение дважды напечатало бы одно содержание дважды — гейт
// структуры этого не ловит (бэклог 55 п. 4), значит, ловит маршрут.
const powtory = [...new Set(wystapienia.map(klucz).filter((k, i, vse) => vse.indexOf(k) !== i))];
if (powtory.length) {
  throw new Error(
    `Вхождение блока объявлено дважды на ${strona.url}: ${powtory.join(', ')} — уберите повтор; ` +
      `второе вхождение с полем role маршрут печатает только у блоков из ROLE_UMIE (ниже).`
  );
}

/**
 * ПОЛЕ БЕЗ БЛОКА — вторая сторона договора (бэклог 44, П52 п. 5 у первого
 * сайта). Поле блока в файле содержания, а блока в `blocks[]` нет, — отказ
 * с именем поля и блока: поле, которое никто не печатает, — тихая заглушка.
 * Карта явная, потому что имена полей и блоков разные (`rows` → `story-row`).
 * Поле, которого карта не знает, — та же тишина в новом месте: каждое поле
 * схемы — или поле страницы, или поле блока, третьего ящика нет.
 */
const POLE_BLOKA: Record<string, string> = {
  rows: 'story-row',
  related: 'link-list',
  cta: 'cta-band',
};
const POLYA_STRANITSY = new Set(['url']);
const obyavleny = new Set(wystapienia.map((b) => b.block));
const est_pole = (pole: string) => {
  const v = (dane as Record<string, unknown>)[pole];
  return v !== undefined && !(Array.isArray(v) && v.length === 0);
};
const bezKarty = Object.keys(dane).filter((pole) => !POLYA_STRANITSY.has(pole) && !(pole in POLE_BLOKA));
if (bezKarty.length) {
  throw new Error(
    `Поле содержания без места в карте POLE_BLOKA на ${strona.url}: ${bezKarty.map((p) => '`' + p + '`').join(', ')}.\n` +
      'Новое поле схемы допишите в POLE_BLOKA (поле блока) или в POLYA_STRANITSY (поле страницы) этого маршрута.'
  );
}
const bezBloka = Object.entries(POLE_BLOKA).filter(([pole, blok]) => est_pole(pole) && !obyavleny.has(blok));
if (bezBloka.length) {
  throw new Error(
    `Поле без блока на ${strona.url}.\n` +
      bezBloka.map(([pole, blok]) => `  поле \`${pole}\` в содержании, а блока \`${blok}\` в blocks[] структуры нет`).join('\n') +
      '\nУберите поле из файла содержания или объявите блок в структуре — поле, которого никто не печатает, — тихая заглушка.'
  );
}

/**
 * РОЛЬ УМЕЕТ ОДИН БЛОК — `story-row`, и остальные разбиваются об это ГРОМКО
 * (форма `ROLE_UMIE` первого сайта; там роль умел `card-rail`, этот маршрут
 * его не печатает). Условия печати ниже спрашивают у остальных блоков голое
 * имя; вхождение с ролью прошло бы сверку и не напечаталось бы. Поэтому
 * граница названа: вхождение с ролью у блока вне списка прерывает сборку.
 */
const ROLE_UMIE = new Set(['story-row']);
const sRolyu = wystapienia.filter((b) => b.role && !ROLE_UMIE.has(b.block));
if (sRolyu.length) {
  throw new Error(
    `Вхождение блока с ролью, которого маршрут ещё не умеет, — ${strona.url}.\n` +
      `  ${sRolyu.map(klucz).join(', ')}\n` +
      `  роль умеют: ${[...ROLE_UMIE].join(', ')}\n` +
      'Научите маршрут этого блока (цикл по вхождениям и содержание по role) или снимите роль в структуре. Тихого пропуска нет.'
  );
}

// Ряд с ролью, которой страница не объявляет, никто бы не напечатал: у каждой
// роли ряда должно быть своё вхождение `story-row` (без роли — вхождение без роли).
const roliVkhozhdeniy = new Set(wystapienia.filter((b) => b.block === 'story-row').map((b) => b.role ?? ''));
const ryadyBezVkhozhdeniya = obyavleny.has('story-row') ? dane.rows.filter((r) => !roliVkhozhdeniy.has(r.role ?? '')) : [];
// Сообщение собрано сложением строк, без шаблона внутри шаблона: вложенный
// шаблон в `${…}` сбивает сканер фронтматтера компилятора Astro — сборка
// проходит, а `astro check` видит фронтматтер незакрытым (ts(1109) на `---`).
const imyaRoli = (role: string) => (role ? 'story-row#' + role : 'story-row');
if (ryadyBezVkhozhdeniya.length) {
  throw new Error(
    `Ряды без своего вхождения story-row на ${strona.url}:\n` +
      ryadyBezVkhozhdeniya.map((r) => '  ряд «' + r.id + '» с ролью ' + (r.role ? '«' + r.role + '»' : '— (без роли)')).join('\n') +
      '\n  вхождения story-row в blocks[]: ' + [...roliVkhozhdeniy].map(imyaRoli).join(', ') + '\n' +
      'Поправьте role ряда или объявите вхождение в структуре.'
  );
}

/**
 * ПОРЯДОК ПЕЧАТИ ЭТОГО ШАБЛОНА — и одновременно список его ветвей. Блок,
 * который ядро умеет, а шаблон не печатает, — отказ «ветви нет» (не тихий
 * пропуск и не «нет содержания»): ветвь приходит с первой страницей формы.
 */
const PORYADOK = ['story-row', 'link-list', 'cta-band'];
const bezVetvi = wystapienia.filter((b) => gotowy(b.block) && !PORYADOK.includes(b.block)).map(klucz);
if (bezVetvi.length) {
  throw new Error(
    `Блок есть в ядре, а ветви маршрута для него нет — ${strona.url}: ${bezVetvi.join(', ')}.\n` +
      `  маршрут печатает: ${PORYADOK.join(', ')}\n` +
      'Ветвь пишется вместе с первой страницей своей формы и её приёмкой глазами (план P4) — не заглушкой.'
  );
}

const pominiete = wystapienia.filter((b) => !gotowy(b.block)).map(klucz);
if (pominiete.length) {
  console.log(`  ${strona.url} — блоки объявлены, но в ядре не реализованы, пропуск: ${pominiete.join(', ')}`);
}
const doZrobienia = wystapienia.filter((b) => gotowy(b.block)).map(klucz);

/**
 * `link-list` печатает `related` структуры, заголовок — из файла содержания.
 * Приписка — вид страницы по типу договора; тип без приписки — отказ:
 * тип, которого у страниц дерева пока нет (`hub`, `map` закрытого словаря),
 * — решение о подписи, а не пустая строка. Считается только у страницы,
 * которая `link-list` объявила («судью судят», раунд 1, R1-MARSHRUT-9).
 */
const VID: Record<string, string> = {
  home: 'Home',
  game: 'Game',
  guide: 'Guide',
  topic: 'Article',
  legal: 'Page',
};
const pokrewne = !obyavleny.has('link-list')
  ? []
  : (strona.related ?? []).map((url) => {
      const cel = getPage(url);
      const vid = VID[cel.type];
      if (!vid) throw new Error(`Тип «${cel.type}» страницы ${url} без приписки в VID маршрута — допишите подпись вида.`);
      return { href: cel.url, title: cel.h1, meta: vid };
    });

// Роль ряда и вхождения — к одному виду: отсутствие и пустая строка — «без роли»
// (раунд 1, R1-MARSHRUT-7: '' в структуре считалось бы здесь ролью, а выше — нет).
const rolOf = (role?: string) => role || '';
const ryadyDlya = (role?: string) => dane.rows.filter((r) => rolOf(r.role) === rolOf(role));

/**
 * ЕСТЬ ЛИ ЧЕМ НАПОЛНИТЬ БЛОК — по предикату на имя. Те же предикаты стоят
 * в условиях печати ниже: список и печать считаются из одного источника.
 */
const maTresc: Record<string, (role?: string) => boolean> = {
  'story-row': (role) => ryadyDlya(role).length > 0,
  'link-list': () => pokrewne.length > 0 && Boolean(dane.related),
  'cta-band': () => Boolean(dane.cta),
};

/**
 * ЧТО ШАБЛОН НАПЕЧАТАЕТ — список, который сверяется с объявленным. Каждое
 * условие печати ниже — `drukowane.includes(ключ)`: список и раскладка
 * из одного источника, и расхождение прерывает сборку (форма первого сайта,
 * 2026-09-10: сравнение `blocks[]` с отфильтрованным `blocks[]` не сторожило
 * печать никогда).
 */
const drukowane = PORYADOK.flatMap((imie) =>
  wystapienia.filter((b) => b.block === imie && gotowy(imie) && (maTresc[imie]?.(b.role) ?? false)).map(klucz)
);

if (doZrobienia.join(',') !== drukowane.join(',')) {
  const brakujace = doZrobienia.filter((k) => !drukowane.includes(k));
  // Причина — у каждого блока, чьё содержание собирается из полей: у призыва
  // это поле `cta` («судью судят», раунд 1, R1-MARSHRUT-4).
  const prichiny = [
    ...(brakujace.includes('link-list')
      ? [pokrewne.length === 0 && 'related структуры пуст', !dane.related && 'нет заголовка related в содержании']
      : []),
    ...(brakujace.includes('cta-band') ? ['нет поля cta в содержании'] : []),
  ].filter(Boolean);
  const pustoVStrukture = prichiny.length ? ` (${prichiny.join('; ')})` : '';
  throw new Error(
    `blocks[] и печать разошлись на ${strona.url}.\n` +
      `  структура объявляет и ядро умеет: ${doZrobienia.join(', ') || '—'}\n` +
      `  шаблон напечатает:                 ${drukowane.join(', ') || '—'}\n` +
      (brakujace.length ? `  без содержания: ${brakujace.join(', ')}${pustoVStrukture}\n` : '  разошёлся только порядок\n') +
      'Поправьте содержание, шаблон или структуру — но не оставляйте расхождения.'
  );
}

/**
 * Ключи кадров издателя на странице — подвалу: нота об арте и класс лицензии
 * печатаются только по ним (П79 п. 3, «на все страницы» — П85 п. 7). Кадр
 * пока печатает одна ветвь — ряд (`art` ряда, пачка 1, П89); ключи берутся
 * из тех же рядов, что печатаются ниже (вхождения из `drukowane`), а сам кадр
 * разрешается здесь, до разметки: ключ без файла или записи прерывает сборку
 * в `kadr()`, а не печатает пустую рамку. Герой и галерея добавят свои ключи
 * вместе со своими ветвями.
 * Пределы («судью судят», раунд 1, R1-MARSHRUT-2, -6): пропорция кадра
 * не судится — ключевой арт-баннер (около 3:1: `hero`, `mp2-art`, `mp3-art`)
 * в рамке ряда 21:13 покажет около половины ширины и растянется на лестнице
 * `640/960/1280`, поэтому в ряды идут скриншоты; один ключ в двух рядах
 * печатает один кадр дважды без отказа; отказ `kadr()` не называет страницу.
 */
const ryadyPechati = wystapienia
  .filter((b) => b.block === 'story-row' && drukowane.includes(klucz(b)))
  .flatMap((b) => ryadyDlya(b.role));
const kadry = new Map(
  [...new Set(ryadyPechati.map((r) => r.art).filter((k): k is string => Boolean(k)))].map((k) => [k, kadr(k)])
);
const kluczeArtu: string[] = [...kadry.keys()];

/*
 * `h1` ПЕЧАТАЕТ МАРШРУТ — заголовок принадлежит странице, а не секции
 * (решение владельца 2026-09-11, бэклог 23 у первого сайта). Роль —
 * `.t-headline`, как у `h1` главной: восемь ролей ядра, новых нет (П85 п. 1).
 * `.page-head` — крючок формы первого сайта; правило у него одно — без нижней
 * отбивки (пачка 1, П86 п. 8, П89): `h1` стоит над первым блоком, а не над
 * пустотой двух отбивок `.section` подряд (стенд `/404/`, около 260 px на 1440).
 * Правило — в `<style>` этого файла: элемент печатает только маршрут. Что
 * `<h1>` ровно один, проверяет сторож сборки `core/gates/after-build.mjs`.
 */
---

<Base title={strona.title} description={strona.description} klucze={kluczeArtu}>
  <header class="page-head container section">
    <h1 class="t-headline" id="page-title">{strona.h1}</h1>
  </header>

  {
    /* Единственный блок, который печатается циклом по вхождениям (ROLE_UMIE):
       ряды каждого вхождения — по его роли. */
    wystapienia
      .filter((b) => b.block === 'story-row' && drukowane.includes(klucz(b)))
      .map((b) =>
        ryadyDlya(b.role).map((ryad) => (
          <StoryRow title={ryad.title} titleId={`${ryad.id}-title`} id={ryad.id} flip={ryad.flip} band={ryad.band}>
            <p class="t-label" slot="nadtytul">{ryad.year}</p>
            <Fragment slot="meta">{ryad.meta}</Fragment>
            <Fragment slot="body">
              {ryad.body.map((abzac) => (
                <p>{abzac}</p>
              ))}
            </Fragment>
            {
              /* Кадр ряда — форма первого сайта (кадр в месте `kadr`); ядро само
                 решает «два столбца или один» по отрисованному месту (П44). */
              ryad.art && (
                <SmartImage
                  slot="kadr"
                  class="kadr-ryadu"
                  src={kadry.get(ryad.art)!.src}
                  alt={kadry.get(ryad.art)!.alt}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 1024px) 92vw, 600px"
                  quality={72}
                />
              )
            }
          </StoryRow>
        ))
      )
  }

  {
    drukowane.includes('link-list') && dane.related && (
      <LinkList items={pokrewne} title={dane.related.title} titleId="related-title" />
    )
  }

  {
    /* Призыв без арта (П89, слова владельца, п. 3): места `art` маршрут
       не подаёт, скрим ядра — как есть (литерал фона первого сайта, бэклог 56
       п. 2); контраст текста принимается замером пикселей собранной страницы. */
    drukowane.includes('cta-band') && dane.cta && (
      <CtaBand title={dane.cta.title} lead={dane.cta.lead} href={dane.cta.href} label={dane.cta.label} id="cta-title">
        <Icon slot="akcja" name="arrow-right" size={18} />
      </CtaBand>
    )
  }
</Base>

<style>
  /* Шапка страницы без нижней отбивки (П86 п. 8, П89): отбивку до `h1` даёт
     верх `.section`, а расстояние до содержания — верх первого блока. Предел
     (раунд 1, R1-MARSHRUT-5): если первым напечатается ряд с `band: true`
     или призыв, фон начнётся прямо под `h1` — сегодня так не устроена ни одна
     страница, держится содержанием, не проверкой. */
  .page-head {
    padding-block-end: 0;
  }

  /* Кадр ряда — дуотон стали, как у панелей рядов главной (`GameRow.astro`:
     те же доли и тот же фильтр) — «Ночь и один фонарь», скриншоты — сталью;
     нота подвала обещает «toned to the site’s colors». Фильтр — двойным
     классом: `.foto img` ядра задаёт свой `filter` с той же специфичностью,
     и перебить его надо при любом порядке листов. `--era` у `.foto` ядро
     не задаёт (он приходит с `:root`), двойной класс там — для единообразия. */
  :global(.foto.kadr-ryadu) {
    --era: color-mix(in oklab, var(--accent-2), var(--ink));
  }

  :global(.foto.kadr-ryadu img) {
    filter: grayscale(1) contrast(1.12) brightness(1.3);
  }
</style>
