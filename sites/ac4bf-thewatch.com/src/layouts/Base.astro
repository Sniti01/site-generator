---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DescentRail from '../components/DescentRail.astro';
import Grain from '@factory/core/effects/Grain.astro';
import Breadcrumbs from '@factory/core/chrome/Breadcrumbs.astro';
import { getBreadcrumbs } from '../lib/structure';

interface Props {
  title: string;
  description: string;
  /** Czy drukować skalę po lewej. Brak — tak. Strony gier jej nie mają: П35
   *  w redakcji z 2026-09-10, po odbiorze okiem. */
  skala?: boolean;
  /** Klucze artu użyte na stronie — stopka drukuje atrybucje tylko dla nich
   *  (П57, odp. 1б). Trasa zbiera je z treści, główna — ze swoich warstw. */
  klucze: string[];
}

const { title, description, skala, klucze } = Astro.props;
const zeSkala = skala !== false;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Okruszki (П57, backlog 17): droga po `parent` struktury — na każdej stronie
// wewnętrznej, między szapką a <main> (poza korytarzem długości, h1 zostaje
// jeden). Główna ma jedno ogniwo i nic nie drukuje. `BreadcrumbList` — ten sam
// obchód w <head>; nie na głównej (lista z jednego ogniwa) i nie na /404/
// (serwer oddaje ją pod każdym cudzym adresem ze statusem 404 — znacznik
// twierdziłby adres, którego nie ma).
const okruszki = getBreadcrumbs(Astro.url.pathname);
const zListaOkruszkow = okruszki.length > 1 && Astro.url.pathname !== '/404/';
const breadcrumbList = zListaOkruszkow
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: okruszki.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        item: new URL(crumb.href, Astro.site).href,
      })),
    })
  : null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="generator" content={Astro.generator} />
    {breadcrumbList && <script is:inline type="application/ld+json" set:html={breadcrumbList} />}
  </head>
  <body class={zeSkala ? undefined : 'bez-skali'}>
    <a class="skip-link t-button" href="#tresc">Przejdź do treści</a>
    {zeSkala && <DescentRail />}
    <SiteHeader />
    <Breadcrumbs trail={okruszki} navLabel="Okruszki" />
    <main id="tresc">
      <slot />
    </main>
    <SiteFooter klucze={klucze} />
    <Grain />

    <style is:global>
      /* Skala zejścia zajmuje lewą krawędź — treść ustępuje jej miejsca.
         KLASA WISI NA BRAKU, nie na obecności: dzięki temu wydruk strony
         głównej nie zmienia się ani o bajt, a stronа bez skali odbiera
         sobie żłób z powrotem. */
      @media (min-width: 1200px) {
        body {
          padding-left: var(--rail);
        }
        body.bez-skali {
          padding-left: 0;
        }
      }

      html.menu-otwarte {
        overflow: hidden;
      }
    </style>
  </body>
</html>
