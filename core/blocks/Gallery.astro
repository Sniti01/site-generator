---
import type { ImageMetadata } from 'astro';
import SmartImage from '../media/SmartImage.astro';

/**
 * Галерея кадров. Имя заведено решением П28 — 57 % документов корпуса,
 * объявлено 23 страницами из 30. **Не путать с примитивом `smart-image`:**
 * тот рисует один кадр, этот — сетку с подписями.
 *
 * ЧТО ПЕЧАТАЕТ ЯДРО: `<section>`, заголовок, сетку `<ul>` и каждый
 * `<li><figure>` со `SmartImage` и `<figcaption>`. Геометрия сетки —
 * конструкция блока, и по правилу П34 она принадлежит ядру вместе с печатью.
 *
 * ЧТО ОТДАЁТ ВИТРИНА: `items` ДАННЫМИ — уже разрешённый `ImageMetadata`,
 * `alt` и подпись. Прецедент `CardRail`: «карты идут данными, а не
 * разметкой», иначе слот пришлось бы повторять на каждый кадр, а число
 * кадров знает страница.
 */
interface Kadr {
  /** Метаданные, уже разрешённые сайтом. Нет источника — `SmartImage`
   *  рисует свой запас. */
  src?: ImageMetadata;
  alt: string;
  /** Подпись под кадром. Нет подписи — нет и `<figcaption>`. */
  caption?: string;
  quality?: number;
  /** Модификаторы оболочки `.foto` — например `foto--gra`. */
  class?: string;
}

interface Props {
  items: Kadr[];
  title: string;
  /** Id заголовка; вяжет `aria-labelledby` секции с самим заголовком. */
  titleId?: string;
  /** Строка под заголовком. Нет — нет и абзаца. */
  lead?: string;
}

const { items, title, titleId, lead } = Astro.props;

/** Ширины и `sizes` считает ядро: сетка его, значит и размер кадра его. */
const SZEROKOSCI = [480, 720, 960];
const SIZES = '(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw';
---

<section class="gallery" aria-labelledby={titleId}>
  <div class="container">
    <h2 class="gallery__title t-headline" id={titleId}>{title}</h2>
    {lead && <p class="gallery__lead t-body measure">{lead}</p>}

    <ul class="gallery__grid">
      {
        items.map((kadr) => (
          <li class="gallery__item">
            <figure class="gallery__figure">
              <div class="gallery__frame">
                <SmartImage
                  src={kadr.src}
                  alt={kadr.alt}
                  widths={SZEROKOSCI}
                  sizes={SIZES}
                  quality={kadr.quality}
                  class={kadr.class}
                />
              </div>
              {kadr.caption && <figcaption class="gallery__caption t-caption">{kadr.caption}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--section-y);
  }

  .gallery__title {
    margin: 0;
    color: var(--ink);
  }

  .gallery__lead {
    margin-top: var(--space-xs);
    color: var(--ink-muted);
  }

  .gallery__grid {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .gallery__figure {
    margin: 0;
  }

  .gallery__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sharp);
    background: var(--bg);
  }

  /* Кадр приходит слотом внутрь рамы: правит его собственная рама ядра,
     поэтому `:global` на потомке здесь законен — та же форма, что
     `.layer__art :global(.foto)` в `StoryRow`. */
  .gallery__frame > :global(.foto),
  .gallery__frame > :global(.skyline) {
    width: 100%;
    height: 100%;
  }

  .gallery__caption {
    margin-top: var(--space-2xs);
    color: var(--ink-muted);
  }
</style>
