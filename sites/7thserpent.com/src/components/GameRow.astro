---
/**
 * Ряд игры на трассе главной (сессия 9, П79; «Трасса пули»). Механизм ряда —
 * ядра: `@factory/core/blocks/StoryRow.astro` (секция, двухколонник,
 * зеркальность, заголовок со связкой доступности, рамка кадра 21:13, ряд
 * без кадра — одним столбцом). Здесь — то, что принадлежит витрине:
 *
 * - КАДР — СТРАНИЦА ГРАФИЧЕСКОЙ НОВЕЛЛЫ (ответ владельца «Панели и подписи»):
 *   три панели из кадров издателя, большая и две малые, между ними —
 *   чёрные поля (фон рамки ядра). У ряда игры — скриншоты своей игры; у ремейка —
 *   кадры оригиналов, в том числе ключевой арт Max Payne 2 (П81). Рисованных
 *   панелей сайта нет. Панели — `SmartImage` ядра, дуотон `.foto`
 *   («Ночь и один фонарь»): светлый конец — сталь, сдвинутая к снегу
 *   (`color-mix` двух токенов), и тон поднят — иначе ночные кадры читаются
 *   тёмными прямоугольниками (финальное ревью impeccable, правка 3; замер
 *   яркости панелей — в докладе).
 * - У РЕМЕЙКА СВОИХ КАДРОВ НЕТ — игра не вышла. Его страница панелей —
 *   из оригиналов, которые он переделывает (сессия 10, П81: Max Payne [10],
 *   [6] и ключевой арт Max Payne 2), плашка называет их оригиналами. Ряд
 *   без кадров (`panels: []`) по-прежнему рисует пустую страницу из трёх
 *   рамок — отсутствие нарисовано, а не оставлено пустым полем (финальное
 *   ревью, правка 2); на главной таких рядов сейчас нет.
 * - КАДРОВКА ПАНЕЛИ, у которой сюжет не в центре, — модификатор
 *   `panele__kadr--lewo` / `--prawo` по полю `kadrowka` данных ряда: панель
 *   режет кадр под свою сторону (`object-fit: cover` ядра), и силуэты ключевого
 *   арта Max Payne 2 (около 57–75 % его ширины) при центре ушли бы за край.
 *   Ключ `kadrowka`, которого нет среди панелей ряда, — прерванная сборка,
 *   а не молча центральный кадр (как неизвестный ключ кадра в `media.ts`).
 * - БАННЕР В МАЛОЙ ПАНЕЛИ — своя лестница ширин (правило `sizes` при
 *   `object-fit: cover`, DESIGN.md первого сайта, «Photography»): ключевой арт
 *   3,1:1 в панели около 1,3:1 кроется по высоте, и браузеру нужна ширина
 *   примерно в 2,4 раза больше ширины панели; иначе он берёт вариант по ширине
 *   и растягивает его (было ×1,55–3,7 — «судью судят» сессии 10). Баннер —
 *   кадр шире 2:1 (пропорция — из записи кредитов). Предел: мастера 1920
 *   не хватает, когда DPR × ширина покрытия больше 1920 — на 1024 px с DPR
 *   около 2,2, при DPR 3 примерно с 775 px, при DPR 4 — с 600 px (до ×1,83);
 *   при DPR 1 и 2 растяжения нет. Скриншоты 4:3 и 16:9 идут прежней
 *   лестницей сессии 9, и у неё свой предел: растяжение и при DPR 1 — 4:3
 *   в большой панели на 700–800 и 1000–1024 px (×1,04–1,22), 16:9 в большой
 *   (до ×1,65) и в малых (до ×1,19); при DPR 2 сильнее (бэклог 59).
 *   Большая панель баннер не принимает — прерванная сборка.
 * - ПЛАШКА РАССКАЗЧИКА под кадром (место `tabliczka`): снег, тёмный текст —
 *   пара `bg` на `ink` в гейте контраста.
 * - УЗЕЛ ТРАССЫ (место `nadtytul`): ромб фонаря на линии `.trasa` в поле
 *   страницы, на высоте первой строки заголовка; от 1360px рядом — год.
 *   Это не надзаголовок (правка 7): узел выносится в поле и стоит на уровне
 *   заголовка, а не над ним. Уровень держится ролью: узел несёт `t-headline`,
 *   его высота — одна строка роли заголовка (`1lh`), отступ сверху — тот же,
 *   что у заголовка ряда в ядре (`--space-xs`). Для чтеца скрыт: год уже есть
 *   в метаданных.
 *
 * `:global` — там, где правило выбирает элемент ядра (`.layer--flip`, `.foto`):
 * форма `:global` на предке, как у таблички первого сайта (REUSE §1.1, сноска ⁸).
 */
import StoryRow from '@factory/core/blocks/StoryRow.astro';
import SmartImage from '@factory/core/media/SmartImage.astro';
import Icon from './Icon.astro';
import { credits, kadr } from '../data/media';
import type { GameRow as Row } from '../data/home';

interface Props {
  row: Row;
  flip: boolean;
  band: boolean;
}

const { row, flip, band } = Astro.props;
const panele = row.panels.map((klucz) => kadr(klucz));
const klucze: readonly string[] = row.panels;
for (const klucz of Object.keys(row.kadrowka ?? {})) {
  if (!klucze.includes(klucz)) {
    throw new Error(`Ряд ${row.id}: kadrowka «${klucz}» — не панель ряда (${row.panels.join(', ')})`);
  }
}
const kadrowka = (i: number) => {
  const strona = row.kadrowka?.[row.panels[i] ?? ''];
  return strona ? `panele__kadr--${strona}` : '';
};
// Пропорция — из записи кредитов (размеры мастера), а не из `src`: чтение
// свойства импортированной картинки помечает её оригинал используемым, и Astro
// кладёт мастер-JPEG в сборку («судью судят», раунд 2, R2-KR-1: 12 файлов, 1,6 МБ).
const baner = (klucz?: string) => {
  const c = klucz ? credits[klucz] : undefined;
  return !!c && c.width / c.height > 2;
};
if (baner(klucze[0])) {
  throw new Error(`Ряд ${row.id}: баннер ${klucze[0]} в большой панели — её лестница ширин под скриншоты`);
}
const malaPanel = (i: number) =>
  baner(klucze[i])
    ? { widths: [640, 960, 1280, 1920], sizes: '(max-width: 1024px) 91vw, 530px' }
    : { widths: [320, 480], sizes: '(max-width: 1024px) 38vw, 220px' };
---

<StoryRow title={row.title} titleId={`${row.id}-title`} id={row.id} flip={flip} band={band}>
  <p class="trasa__wezel t-headline" slot="nadtytul" aria-hidden="true">
    <span class="trasa__rok t-label tabular">{row.year}</span>
  </p>

  <Fragment slot="meta">{row.meta}</Fragment>

  <Fragment slot="body">{row.body}</Fragment>

  <a class="btn-link t-button gra__link" href={row.href} slot="tresc">
    {row.linkLabel}<Icon name="arrow-right" size={18} />
  </a>

  {
    panele.length === 3 ? (
      <div class="panele" slot="kadr">
        <SmartImage
          class={`panele__glowny ${kadrowka(0)}`.trim()}
          src={panele[0].src}
          alt={panele[0].alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 1024px) 60vw, 360px"
          quality={72}
        />
        <SmartImage
          class={kadrowka(1) || undefined}
          src={panele[1].src}
          alt={panele[1].alt}
          {...malaPanel(1)}
          quality={72}
        />
        <SmartImage
          class={kadrowka(2) || undefined}
          src={panele[2].src}
          alt={panele[2].alt}
          {...malaPanel(2)}
          quality={72}
        />
      </div>
    ) : (
      <div class="panele panele--puste" slot="kadr" aria-hidden="true">
        <span class="panele__pusty panele__glowny" />
        <span class="panele__pusty" />
        <span class="panele__pusty" />
      </div>
    )
  }

  {
    row.caption && (
      <p class="plashka t-title" slot="tabliczka">
        {row.caption}
      </p>
    )
  }
</StoryRow>

<style>
  /* Страница новеллы: большая панель во всю высоту, две малые стопкой.
     Поля — зазор сетки поверх фона рамки ядра (`--bg`); у зеркального ряда
     страница зеркальна целиком — большая панель и там у колонки текста. */
  .panele {
    --era: color-mix(in oklab, var(--accent-2), var(--ink));
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-2xs);
  }

  /* Тон панелей: ядро кладёт `grayscale(1) contrast(1.08)`; здесь светлее,
     чтобы света ночных кадров доходили почти до снега. */
  .panele :global(.foto img) {
    filter: grayscale(1) contrast(1.12) brightness(1.3);
  }

  .panele :global(.panele__glowny) {
    grid-row: 1 / -1;
  }

  /* Кадровка по стороне (поле `kadrowka` данных ряда). Числа — под пару
     «панель и кадр»: 78 % — малая панель около 1,3:1 и ключевой арт
     Max Payne 2 3,1:1 (силуэты на 57–75 % его ширины); 30 % — большая панель
     около 1:1 и скриншот 4:3 (фигура Макса в левой трети). */
  .panele :global(.panele__kadr--prawo img) {
    object-position: 78% 50%;
  }

  .panele :global(.panele__kadr--lewo img) {
    object-position: 30% 50%;
  }

  :global(.layer--flip) .panele {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
  }

  :global(.layer--flip) .panele :global(.panele__glowny) {
    grid-column: 2;
  }

  /* Пустая страница ремейка: рамки панелей без кадров. */
  .panele__pusty {
    display: block;
    border: 1px solid var(--hairline-strong);
    background: var(--bg-band);
  }

  /* Плашка рассказчика: снег под тёмным текстом, край — ночь страницы.
     Заходит на кадр снизу, как подпись на странице новеллы. */
  .plashka {
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 22rem;
    margin-top: calc(var(--space-xl) * -1);
    margin-inline-start: var(--space-lg);
    padding: var(--space-xs) var(--space-sm);
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--radius-none);
    outline: var(--space-3xs) solid var(--bg);
  }

  :global(.layer--flip) .plashka {
    margin-inline: auto var(--space-lg);
  }

  .gra__link {
    margin-top: var(--space-lg);
  }

  /* Узел трассы. Статическое положение по вертикали — начало колонки текста;
     отступ сверху и высота строки — как у заголовка ряда (роль `t-headline`,
     `margin-top: var(--space-xs)` у `.layer__headline` в ядре), поэтому ромб
     и год стоят посередине первой строки заголовка. По горизонтали — на линии
     `.trasa` (`--trasa-x`), центр ромба на линии. */
  .trasa__wezel {
    position: absolute;
    left: calc(var(--trasa-x) - var(--space-3xs));
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    height: 1lh;
    margin-top: var(--space-xs);
  }

  .trasa__wezel::before {
    content: '';
    flex: none;
    width: var(--space-2xs);
    height: var(--space-2xs);
    background: var(--accent);
    transform: rotate(45deg);
  }

  .trasa__rok {
    display: none;
    color: var(--accent-text);
  }

  @media (min-width: 1360px) {
    .trasa__rok {
      display: block;
    }
  }

  /* На телефоне поле колонки узкое (16px), и ромб у первой строки заголовка
     читался бы маркером списка, приклеенным к нему (проверочный проход ревью,
     регрессия 1): узел уходит вверх, в воздух между рядами, на ту же линию. */
  @media (max-width: 640px) {
    .trasa__wezel {
      translate: 0 calc(var(--section-y) / -2);
    }
  }

  @media (max-width: 1024px) {
    :global(.layer--flip) .plashka {
      margin-inline: var(--space-md) auto;
    }
  }

  @media (max-width: 560px) {
    .plashka,
    :global(.layer--flip) .plashka {
      margin-inline: var(--space-sm) auto;
    }
  }
</style>
