---
/**
 * Каркас страницы (сессия 3, П62): голова документа, пропуск к содержанию,
 * шапка и подвал ядра, единственный <main>; зерно ядра `Grain` поверх всей
 * страницы — после подвала, как у первого сайта (сессия 8, П74 п. 1).
 *
 * Иконки сайта (сессия 11, П83 и дополнение) — из знака «Семёрка из трассы»:
 * файлы в `public/` пишет `tools/znak.mjs` из `src/data/znak.json` и токенов
 * (`npm run znak`; `npm run znak:check` сверяет файлы и эти ссылки). Chromium
 * берёт `favicon.svg` при любом порядке ссылок (проверено на Chromium 151,
 * с окном и без); `favicon.ico` помечен `sizes="32x32"`, чтобы браузер,
 * читающий размеры, не предпочёл его SVG. PNG — запасные для браузеров без
 * SVG-иконок, 192 — ярлык Android, `apple-touch-icon` — домашний экран iOS.
 *
 * Чего здесь ещё нет — и это решение, не пропуск: крошек и `BreadcrumbList`
 * (`getBreadcrumbs` бросает при `pages: []` — приходят вместе с деревом S2),
 * JSON-LD страницы.
 */
import '../styles/global.css';
import Grain from '@factory/core/effects/Grain.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Ключи кадров издателя, показанных на странице, — подвал печатает ноту
   *  об арте и класс лицензии только для них (сессия 9, П79 п. 3). */
  klucze?: string[];
}

const { title, description, klucze = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#090c11" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link t-button" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter klucze={klucze} />
    <Grain />
  </body>
</html>
