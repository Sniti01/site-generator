---
/**
 * Stóg tej witryny: koniec zejścia, cztery działy katalogu. Plik istnieje
 * po to, żeby `index.astro` zostało przy samym `<CatalogStack />`, a dane
 * katalogu, polskie zdania i ikona mieszkały po tej stronie granicy.
 *
 * Mechanizm siatki jest w rdzeniu: `@factory/core/blocks/LinkColumns.astro`.
 * Tutaj nie ma `<style>` i nie powinno go być: wszystkie reguły `.stack*`
 * dotyczą elementów, które rysuje rdzeń.
 */
import LinkColumns from '@factory/core/blocks/LinkColumns.astro';
import { catalog } from '../data/site';
import Icon from './Icon.astro';
---

<LinkColumns groups={catalog} title="Stóg" label="Otwórz pełny katalog" href="/poradniki/">
  <Fragment slot="lead">
        Wylądowałeś. Cały katalog leży tutaj — ułożony według tego, co chcesz zrobić, a nie
        według tego, w którą część grasz.
      </Fragment>

  <Icon slot="akcja" name="strzalka-w-prawo" size={18} />
</LinkColumns>
