---
import { eras } from '../data/site';

/**
 * Skala zejścia. Po lewej krawędzi, przez całą stronę: wysokość zamienia się
 * w lata. Znacznik jedzie ze scrollem, aktywna epoka podświetla się swoim
 * kolorem — to ten sam token, którym maluje się jej sekcja.
 */
---

<aside class="rail" aria-hidden="true">
  <span class="rail__cap t-micro">iglica</span>

  <div class="rail__track">
    <span class="rail__fill"></span>
    {
      eras.map((era) => (
        <span class="rail__tick" data-era={era.id} style={`--at:${era.depth}%`}>
          <span class="rail__dash" />
          <span class="rail__year t-micro tabular">{era.year}</span>
        </span>
      ))
    }
    <span class="rail__marker"></span>
  </div>

  <span class="rail__cap t-micro">stóg</span>
</aside>

<script>
  const rail = document.querySelector<HTMLElement>('.rail');
  const ticks = Array.from(document.querySelectorAll<HTMLElement>('.rail__tick'));
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-era-section]'));
  if (rail && ticks.length) {
    let queued = false;

    const draw = () => {
      queued = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      rail.style.setProperty('--progress', `${(progress * 100).toFixed(2)}%`);
    };

    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(draw);
      },
      { passive: true },
    );
    // Znaczniki lat muszą stać tam, gdzie naprawdę wypada środek warstwy.
    // Wartość z danych to tylko fallback zanim skrypt wstanie.
    const place = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      for (const layer of layers) {
        const tick = ticks.find((node) => node.dataset.era === layer.dataset.eraSection);
        if (!tick) continue;
        const centre = layer.offsetTop + layer.offsetHeight / 2 - window.innerHeight / 2;
        const at = Math.min(1, Math.max(0, centre / scrollable));
        tick.style.setProperty('--at', `${(at * 100).toFixed(2)}%`);
      }
    };

    addEventListener('resize', () => {
      place();
      draw();
    }, { passive: true });
    addEventListener('load', place);
    place();
    draw();

    // Aktywna epoka: ta, której warstwa zajmuje środek ekranu.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).dataset.eraSection;
          const tick = ticks.find((node) => node.dataset.era === id);
          tick?.classList.toggle('is-active', entry.isIntersecting);
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    layers.forEach((layer) => observer.observe(layer));
  }
</script>

<style>
  .rail {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    width: var(--rail);
    height: 100vh;
    padding-block: var(--space-lg);
    border-right: 1px solid var(--hairline);
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    pointer-events: none;
    --era-fill: var(--accent);
  }

  .rail__cap {
    color: var(--ink-muted);
  }

  .rail__track {
    position: relative;
    flex: 1;
    width: 1px;
    background: var(--hairline-strong);
  }

  .rail__fill {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: var(--progress, 0%);
    background: var(--era-fill);
    transition: background-color 320ms var(--ease-out);
  }

  .rail__tick {
    position: absolute;
    top: var(--at);
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    transform: translate(-50%, -50%);
    color: var(--ink-muted);
    transition: color 180ms var(--ease-out);
  }

  .rail__dash {
    width: 9px;
    height: 1px;
    background: currentColor;
  }

  .rail__year {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .rail__tick.is-active {
    color: var(--era-text);
  }

  .rail__tick.is-active .rail__dash {
    width: 15px;
    height: 2px;
  }

  .rail__marker {
    position: absolute;
    top: var(--progress, 0%);
    left: 50%;
    width: 7px;
    height: 7px;
    background: var(--era-fill);
    transform: translate(-50%, -50%) rotate(45deg);
    transition: background-color 320ms var(--ease-out);
  }

  /* Kolor znacznika bierze się z epoki, nad którą właśnie stoimy. */
  .rail:has(.rail__tick.is-active[data-era='jerozolima']) {
    --era-text: var(--era-jerozolima-text);
    --era-fill: var(--era-jerozolima);
  }
  .rail:has(.rail__tick.is-active[data-era='wlochy']) {
    --era-text: var(--era-wlochy-text);
    --era-fill: var(--era-wlochy);
  }
  .rail:has(.rail__tick.is-active[data-era='karaiby']) {
    --era-text: var(--era-karaiby-text);
    --era-fill: var(--era-karaiby);
  }
  .rail:has(.rail__tick.is-active[data-era='londyn']) {
    --era-text: var(--era-londyn-text);
    --era-fill: var(--era-londyn);
  }
  .rail:has(.rail__tick.is-active[data-era='japonia']) {
    --era-text: var(--era-japonia-text);
    --era-fill: var(--era-japonia);
  }

  @media (min-width: 1200px) {
    .rail {
      display: flex;
    }
  }
</style>
