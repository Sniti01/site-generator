---
/**
 * Пауза главной — реплика Макса (сессия 9, П79). Механизм полосы — ядра:
 * `@factory/core/blocks/BandQuote.astro` (смена среды, свечение фонаря,
 * волосы сверху и снизу, узкая мера). Здесь — слова и приём графической
 * новеллы: реплика набрана в снежной плашке рассказчика, каждая строка —
 * своя полоса снега (`box-decoration-break: clone`), тёмный текст — пара
 * `bg` на `ink` в гейте контраста. Орнамента нет: полосу пересекает трассер.
 *
 * Цитата короткая, с игрой и главой (П67 п. 2); источник — в `src/data/home.ts`.
 * Капслок роли `t-headline` на короткой реплике — как у полосы первого
 * сайта; длинные цитаты — к пачке 0 (бэклог 57 п. 6).
 */
import BandQuote from '@factory/core/blocks/BandQuote.astro';
import { quote } from '../data/home';
---

<div class="pauza">
  <BandQuote id="quote-title">
    <Fragment slot="cytat"><span class="cytat">“{quote.text}”</span></Fragment>
    <Fragment slot="tresc">{quote.source}</Fragment>
  </BandQuote>
</div>

<style>
  /* Дымка полосы — сталью, не фонарём. Ядро кладёт радиальное свечение
     `--accent`: на этой полосе фонаря нет, и тёплая дымка была бы вторым
     тёплым светом страницы (финальное ревью impeccable, правка 8). Форма
     свечения — ядра, сменён только цвет; оверрайд через обёртку `.pauza`. */
  .pauza :global(.creed) {
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in oklab, var(--accent-2) 14%, transparent), transparent 62%),
      var(--bg-band);
  }

  /* Высота строки больше, чем у роли (1.14): у каждой строки своя полоса
     снега, и полоса следующей строки не должна ложиться на буквы предыдущей. */
  .cytat {
    line-height: 1.6;
    padding: var(--space-3xs) var(--space-xs);
    background: var(--ink);
    color: var(--bg);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
