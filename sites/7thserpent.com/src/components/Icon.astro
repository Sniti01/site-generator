---
/**
 * Иконка витрины. Файл существует, чтобы вызовы оставались при самом `name`,
 * а имя проверялось типом `IconName`: ядро принимает словарь, и на его
 * границе тип имён исчезает.
 */
import CoreIcon from '@factory/core/primitives/Icon.astro';
import { iconPaths, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
---

<CoreIcon name={name} paths={iconPaths} size={size} class={className} />
