---
/**
 * Pasmo wezwania do działania tej witryny. Plik istnieje po to, żeby
 * `index.astro` zostało przy samym `<CtaBand />`, a wszystko, co należy
 * do witryny — polskie zdania, adres poradnika, rysowana panorama i ikona —
 * mieszkało po tej stronie granicy.
 *
 * Mechanizm pasma jest w rdzeniu: `@factory/core/blocks/CtaBand.astro`.
 * Tutaj zostaje sam art i reguła, która go pozycjonuje — muszą być w jednym
 * komponencie, bo `data-astro-cid-*` wiąże regułę z elementem po skrócie.
 */
import CoreCtaBand from '@factory/core/blocks/CtaBand.astro';
import Icon from './Icon.astro';
---

<CoreCtaBand
  title="Nie wiesz, od której części zacząć?"
  lead="Jeden tekst układa całą serię chronologicznie i mówi, co można spokojnie pominąć."
  href="/poradniki/od-czego-zaczac/"
  label="Przeczytaj przewodnik dla nowych"
>
  <svg
    slot="art"
    class="cta__art"
    viewBox="0 0 1600 320"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="cta-glow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#dc4e40" stop-opacity="0" />
        <stop offset="100%" stop-color="#dc4e40" stop-opacity="0.22" />
      </linearGradient>
    </defs>
    <rect width="1600" height="320" fill="url(#cta-glow)" />
    <g fill="#0a0908">
      <path
        d="M0 268h84v-40h58v40h96v-58h56v58h120v-34h58v34h104v-52h60v52h128v-42h56v42h140v-30h46v30h60v52H0z"
      ></path>
    </g>
    <g fill="#0a0908" opacity="0.6">
      <path d="M600 232c-8 22-8 40 0 56h-14c-8-16-8-34 0-56z"></path>
      <path d="M1004 214c-10 28-10 52 0 74h-16c-10-22-10-46 0-74z"></path>
    </g>
  </svg>

  <Icon slot="akcja" name="strzalka-w-prawo" size={18} />
</CoreCtaBand>

<style>
  .cta__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
