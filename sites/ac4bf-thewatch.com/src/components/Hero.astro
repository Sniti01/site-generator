---
import HeroKeyArt from '@factory/core/blocks/HeroKeyArt.astro';
import ChipNav from '@factory/core/blocks/ChipNav.astro';
import Viewpoint from './Viewpoint.astro';
import EraMedia from './EraMedia.astro';
import gameArt from '../data/game-art.json';
import Icon from './Icon.astro';
import { eras } from '../data/site';

/**
 * Pierwszy ekran tej witryny. Plik istnieje po to, żeby `index.astro` zostało
 * przy samym `<Hero />`, a wszystko, co należy do witryny — art i jego duoton,
 * polskie zdania z własnym `<i>`, adresy kotwic, słownik epok i ich paleta —
 * mieszkało po tej stronie granicy.
 *
 * Mechanizm ekranu jest w rdzeniu: `@factory/core/blocks/HeroKeyArt.astro`,
 * polska czipów — `@factory/core/blocks/ChipNav.astro`.
 *
 * DLACZEGO ART ZOSTAJE TUTAJ. Reguła ustawiająca art jest nieodłączna
 * od samego artu: `data-astro-cid-*` wiąże je po skrócie, więc reguła w jednym
 * komponencie, a element w drugim — to ciche zgubienie oprawy
 * (`docs/REUSE.md` §1.1, przypis ² i ¹). Razem z `.hero__art` zostają jego
 * duoton, obie reguły w medizapytaniach i podpis wysokości.
 *
 * DLACZEGO PALETA CZIPÓW MA `:global`. Czip rysuje rdzeń, więc niesie JEGO
 * skrót; reguła zapisana tutaj zwyczajnie dostałaby skrót tego pliku i po cichu
 * przestałaby pasować. Element przenieść się nie może — przenosi się zasięg
 * reguły. Tak samo jak przy palecie taśmy w `CardRail` i palecie rzędów
 * w `StoryRow`.
 *
 * DLACZEGO LID IDZIE MIEJSCEM. Ma własne formatowanie: zagnieżdżone `<i>`
 * i przełamanie wiersza wewnątrz węzła tekstowego. Props-łańcuch odtworzyłby
 * je spacjami, a wtedy znacznik rozjechałby się tam, gdzie wygląd się nie
 * zmienia (zapis `DECISIONS.md` z 2026-09-07 o propsach i slotach).
 */
const kluczowyArt = Boolean((gameArt as Record<string, unknown>).hero);

/*
  Wartości powyżej 100vw są celowe. `sizes` opisuje szerokość, a panel
  pierwszego ekranu jest niemal kwadratowy, podczas gdy kluczowy art ma
  proporcję 3:1. Przy object-fit: cover przeglądarka musi pokryć wysokość,
  więc realnie potrzebuje około 3,1 × wysokości panelu w pikselach źródła
  — prawie trzy razy więcej, niż wynika z samej szerokości. Bez tego
  wybierała wariant 979 px i rozciągała go 2,5-krotnie.

  Komentarz stoi w części skryptowej, a nie w liście atrybutów: tam Astro
  parsuje słowa komentarza blokowego jako atrybuty komponentu — stąd ts(2322).
*/
const heroSizes = '(max-width: 1024px) 200vw, 170vw';
---

<HeroKeyArt
  title="Cała seria według lat"
  titleId="hero-tytul"
  primaryHref="#zejscie"
  primaryLabel="Zacznij zejście"
  secondaryHref="#katalog"
  secondaryLabel="Katalog poradników"
>
  <div class="hero__art" slot="art">
    <EraMedia
      klucz="hero"
      widths={[1200, 1600, 2400, 3200]}
      sizes={heroSizes}
      loading="eager"
      credit={false}
    />
    {!kluczowyArt && <Viewpoint bare />}
  </div>

  <Fragment slot="lead">
      <p class="hero__lead t-lead measure">
        Zaczynasz na iglicy, schodzisz przez pięć stuleci i lądujesz w tym poradniku, po który
        przyszedłeś. Nieoficjalny przewodnik po <i>Assassin’s Creed</i> — bez tagów, po latach.
      </p>
  </Fragment>

  <Icon slot="ikona-glowna" name="w-dol" size={18} />

  <ChipNav
    slot="nawigacja"
    label="Skok do epoki"
    chips={eras.map((era) => ({
      href: `#epoka-${era.id}`,
      title: era.year,
      meta: era.place,
      modifier: `hero__chip--${era.id}`,
    }))}
  />

  {
    !kluczowyArt && (
      <span class="hero__height t-micro tabular" slot="dopisek" aria-hidden="true">
        wysokość 42 m
      </span>
    )
  }
</HeroKeyArt>

<style>
  .hero__art {
    position: absolute;
    inset: 0 0 0 32%;
    /* Duoton dotyczy tylko wariantu fotograficznego; kluczowy art gry idzie
       w pełnym kolorze. Mosiądz zostaje jako kolor miasta pod sylwetką. */
    --era: var(--accent-2);
  }

  .hero__art :global(.foto),
  .hero__art :global(.skyline) {
    width: 100%;
    height: 100%;
  }

  .hero__lead {
    margin-top: var(--space-md);
    color: var(--ink-muted);
  }

  .hero__lead i {
    font-style: normal;
    color: var(--ink);
  }

  :global(.hero__chip--jerozolima) {
    --era-text: var(--era-jerozolima-text);
  }
  :global(.hero__chip--wlochy) {
    --era-text: var(--era-wlochy-text);
  }
  :global(.hero__chip--karaiby) {
    --era-text: var(--era-karaiby-text);
  }
  :global(.hero__chip--londyn) {
    --era-text: var(--era-londyn-text);
  }
  :global(.hero__chip--japonia) {
    --era-text: var(--era-japonia-text);
  }

  .hero__height {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-md);
    z-index: 1;
    color: var(--ink-muted);
  }

  @media (max-width: 1024px) {
    .hero__art {
      inset: 0 -20% 0 20%;
      opacity: 0.75;
    }
  }

  @media (max-width: 640px) {
    .hero__art {
      position: relative;
      inset: auto;
      flex: none;
      height: 40vh;
      min-height: 260px;
      opacity: 1;
    }
    .hero__height {
      display: none;
    }
  }
</style>
