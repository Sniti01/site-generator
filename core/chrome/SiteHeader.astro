---
/**
 * `site-header` — липкая шапка: бренд, меню, поиск и бургер с ящиком.
 *
 * Механизм, не содержание. Ядро держит раскладку 68px, поведение поиска
 * с горячей клавишей `/`, ящик и переключение состояний бургера. Слова,
 * адреса и данные меню приходят пропсами; знак и все четыре иконки —
 * именованными слотами.
 *
 * СОСТОЯНИЯ БУРГЕРА — ИМЕНОВАННЫЕ МЕСТА, А НЕ ИКОНКИ. Ядро объявляет два
 * места, `ikona-menu` и `ikona-zamknij`, и переключает их видимость по
 * `aria-expanded`. Что в них лежит, механика не знает и знать не должна:
 * размеров иконкам она не задаёт, перехода между состояниями не анимирует.
 * Это рамка владельца от 2026-09-07 и она здесь выполнима без оговорок.
 *
 * ПОЧЕМУ ОБА МЕСТА РИСУЕТ ЯДРО, А НЕ САЙТ. Переключение записано
 * потомковыми селекторами — `.hdr__burger[aria-expanded='true']
 * .hdr__burger-open`, — а Astro требует скрут `data-astro-cid-*` на обоих
 * элементах такого селектора. Отдай сайту сами `<span>`-места, и правило
 * молча перестанет работать. Сайт наполняет места, но не создаёт их.
 * То же у `.hdr__drawer-search .hdr__input`.
 *
 * Иконка поиска подаётся двумя слотами, а не одним: форм две — настольная
 * и в ящике, — а слот содержимое не размножает.
 */
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  /** Пункты главного меню; рисуются дважды — в строке и в ящике. */
  items: NavItem[];
  /** Ссылка знака и её подпись для скринридера. */
  brandHref?: string;
  brandLabel: string;
  /** Подпись самого меню для скринридера. */
  navLabel: string;
  /** Куда уходит форма поиска. */
  searchAction: string;
  /** Подпись поля и подсказка в нём — одни и те же в обеих формах. */
  searchLabel: string;
  searchPlaceholder: string;
  /** Подпись кнопки-бургера для скринридера. */
  burgerLabel: string;
  /** Идентификаторы в DOM: связывают label с полем и кнопку с ящиком. */
  searchId?: string;
  drawerSearchId?: string;
  drawerId?: string;
}

const {
  items,
  brandHref = '/',
  brandLabel,
  navLabel,
  searchAction,
  searchLabel,
  searchPlaceholder,
  burgerLabel,
  searchId = 'q',
  drawerSearchId = 'q-mobilne',
  drawerId = 'menu-mobilne',
} = Astro.props;
---

<header class="hdr">
  <div class="hdr__inner container">
    <a class="hdr__brand" href={brandHref} aria-label={brandLabel}>
      <slot name="znak" />
    </a>

    <nav class="hdr__nav" aria-label={navLabel}>
      <ul class="hdr__list">
        {
          items.map((item) => (
            <li>
              <a class="hdr__link t-label" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form class="hdr__search" role="search" action={searchAction} method="get">
      <label class="visually-hidden" for={searchId}>{searchLabel}</label>
      <span class="hdr__search-icon"><slot name="ikona-szukaj" /></span>
      <input
        class="hdr__input t-caption"
        id={searchId}
        name="q"
        type="search"
        placeholder={searchPlaceholder}
        autocomplete="off"
      />
      <kbd class="hdr__kbd t-micro">/</kbd>
    </form>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls={drawerId}>
      <span class="hdr__burger-open"><slot name="ikona-menu" /></span>
      <span class="hdr__burger-close"><slot name="ikona-zamknij" /></span>
      <span class="visually-hidden">{burgerLabel}</span>
    </button>
  </div>

  <div class="hdr__drawer" id={drawerId} hidden>
    <div class="container">
      <form class="hdr__drawer-search" role="search" action={searchAction} method="get">
        <label class="visually-hidden" for={drawerSearchId}>{searchLabel}</label>
        <span class="hdr__search-icon"><slot name="ikona-szukaj-mobilne" /></span>
        <input
          class="hdr__input t-caption"
          id={drawerSearchId}
          name="q"
          type="search"
          placeholder={searchPlaceholder}
          autocomplete="off"
        />
      </form>
      <ul class="hdr__drawer-list">
        {
          items.map((item) => (
            <li>
              <a class="hdr__drawer-link t-title" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.hdr__burger');
  const drawer = document.querySelector<HTMLElement>('.hdr__drawer');

  const close = () => {
    burger?.setAttribute('aria-expanded', 'false');
    if (drawer) drawer.hidden = true;
    document.documentElement.classList.remove('menu-otwarte');
  };

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    if (open) {
      close();
      return;
    }
    burger.setAttribute('aria-expanded', 'true');
    if (drawer) drawer.hidden = false;
    document.documentElement.classList.add('menu-otwarte');
  });

  drawer?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) close();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      close();
      burger.focus();
      return;
    }

    // Ukośnik skacze do wyszukiwania — tak jak w każdym serwisie z poradnikami.
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const active = document.activeElement;
    if (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement) return;
    const field = document.querySelector<HTMLInputElement>('.hdr__search .hdr__input');
    if (!field || field.offsetParent === null) return;
    event.preventDefault();
    field.focus();
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--hairline);
    backdrop-filter: blur(14px);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: 68px;
  }

  .hdr__brand {
    flex: none;
    text-decoration: none;
  }

  .hdr__nav {
    flex: 1;
    min-width: 0;
  }

  .hdr__list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hdr__link {
    display: inline-block;
    padding-block: var(--space-2xs);
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 180ms var(--ease-out);
  }

  .hdr__link:hover {
    color: var(--ink);
  }

  .hdr__search,
  .hdr__drawer-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hdr__search {
    flex: none;
    width: 280px;
  }

  .hdr__search-icon {
    position: absolute;
    left: var(--space-xs);
    display: flex;
    color: var(--ink-muted);
    pointer-events: none;
  }

  .hdr__input {
    width: 100%;
    height: 40px;
    padding-inline: var(--space-xl) var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sharp);
    color: var(--ink);
  }

  .hdr__input::placeholder {
    color: var(--ink-muted);
  }

  .hdr__input:hover {
    border-color: var(--hairline-strong);
  }

  .hdr__input:focus-visible {
    border-color: var(--accent);
    outline-offset: 1px;
  }

  .hdr__input::-webkit-search-cancel-button {
    filter: invert(1) opacity(0.5);
  }

  .hdr__kbd {
    position: absolute;
    right: var(--space-2xs);
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--ink-muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sharp);
    pointer-events: none;
  }

  .hdr__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-xs) * -1);
    background: transparent;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }

  .hdr__burger-open,
  .hdr__burger-close {
    display: flex;
  }

  .hdr__burger-close,
  .hdr__burger[aria-expanded='true'] .hdr__burger-open {
    display: none;
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-close {
    display: flex;
  }

  .hdr__drawer {
    border-top: 1px solid var(--hairline);
    background: var(--bg-band);
  }

  .hdr__drawer-search {
    margin-block: var(--space-md) var(--space-2xs);
  }

  .hdr__drawer-search .hdr__input {
    height: 48px;
    padding-inline: var(--space-xl) var(--space-md);
  }

  .hdr__drawer-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-block: var(--space-2xs) var(--space-sm);
    list-style: none;
  }

  .hdr__drawer-link {
    display: block;
    padding-block: var(--space-xs);
    color: var(--ink);
    text-decoration: none;
  }

  @media (max-width: 1180px) {
    .hdr__search {
      width: 220px;
    }
    .hdr__list {
      gap: var(--space-sm);
    }
  }

  @media (max-width: 960px) {
    .hdr__nav,
    .hdr__search {
      display: none;
    }
    .hdr__inner {
      justify-content: space-between;
    }
    .hdr__burger {
      display: inline-flex;
    }
  }

  @media (min-width: 961px) {
    .hdr__drawer {
      display: none;
    }
  }
</style>
