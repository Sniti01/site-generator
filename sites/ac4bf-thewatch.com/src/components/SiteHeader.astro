---
/**
 * Szapka tej witryny. Plik istnieje po to, żeby `Base.astro` zostało przy
 * samym `<SiteHeader />`, a dane menu, znak, polskie napisy i ikony
 * mieszkały po tej stronie granicy.
 *
 * Mechanizm jest w rdzeniu: `@factory/core/chrome/SiteHeader.astro`.
 * Tutaj nie ma `<style>` i nie powinno go być: każda reguła `.hdr*` dotyczy
 * elementu, który rysuje rdzeń — łącznie z dwoma `<span>`-ami stanów
 * burgera. Rdzeń tworzy miejsca, witryna je wypełnia.
 *
 * Ikona szukania idzie dwoma slotami, bo formularze są dwa: w pasku
 * i w szufladzie. Slot zawartości nie powiela.
 */
import CoreSiteHeader from '@factory/core/chrome/SiteHeader.astro';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';
---

<CoreSiteHeader
  items={nav}
  brandLabel="Bractwo — strona główna"
  navLabel="Główne"
  searchAction="/szukaj/"
  searchLabel="Szukaj poradnika"
  searchPlaceholder="Szukaj poradnika…"
  burgerLabel="Menu i wyszukiwarka"
>
  <Wordmark slot="znak" />
  <Icon slot="ikona-szukaj" name="szukaj" size={18} />
  <Icon slot="ikona-szukaj-mobilne" name="szukaj" size={18} />
  <Icon slot="ikona-menu" name="menu" size={22} />
  <Icon slot="ikona-zamknij" name="zamknij" size={22} />
</CoreSiteHeader>
