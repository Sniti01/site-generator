---
import type { EraId } from '../data/site';
import { mediaFor } from '../data/media';
import SmartImage from '@factory/core/media/SmartImage.astro';
import EraSkyline from './EraSkyline.astro';

/**
 * Kadr epoki: cienka warstwa między rozstrzygaczem źródła a rdzeniem.
 *
 * Trzy poziomy źródła — materiał gry, zdjęcie z Commons, rysowana panorama —
 * rozstrzyga `src/data/media.ts`. Ramkę, `astro:assets` i dwa miejsca daje
 * rdzeń: `@factory/core/media/SmartImage.astro`. Tutaj zostaje tylko to, czego
 * nie umie ani jeden, ani drugi: forma podpisu przy każdym źródle i to, że
 * zapasem tej witryny jest `EraSkyline`.
 *
 * DLACZEGO ROZSTRZYGACZ WYPROWADZONY DO MODUŁU. `CardRail` rysuje karty
 * z danych, więc metadane kadru muszą powstać w części skryptowej, zanim
 * zacznie się rysowanie — a komponentu z frontmattera nie wywołasz. Jeden
 * rozstrzygacz obsługuje oba wywołania; drugiego globa w witrynie nie ma.
 */
interface Props {
  /** Epoka albo `hero`: klucz pliku i wpisu w plikach kredytowych.
   *
   *  NAZWA `slot` JEST ZAKAZANA i to nie jest kwestia gustu. Gdy komponent
   *  trafia do miejsca rodzica, kompilator czyta `slot={…}` jako ADRES
   *  miejsca, a nie jako props: `<Fragment slot="kadr"><EraMedia slot={id} />`
   *  kompiluje się do `renderComponent(Fragment, …, { [id]: … })`, a Fragment
   *  rysuje wyłącznie miejsce bez nazwy. Kadr znika po cichu, przy zielonym
   *  buildzie i zielonych bramkach. Zmierzone kompilatorem przy wynoszeniu
   *  `story-row` (raport 2026-09-09). */
  klucz: EraId | 'hero';
  /** Do koloru duotonu, gdy w grę wchodzi wariant fotograficzny. */
  era?: EraId;
  /** Domyślnie opis z manifestu (foto) albo nazwa gry (materiał gry). */
  alt?: string;
  sizes: string;
  widths: number[];
  loading?: 'lazy' | 'eager';
  /** Podpis w kadrze. Przy materiałach gry domyślnie zbędny: nazwę gry niesie
   *  tabliczka obok, a notę o prawach — stopka. */
  credit?: boolean;
  class?: string;
}

const {
  klucz,
  era,
  alt,
  sizes,
  widths,
  loading = 'lazy',
  credit = true,
  class: className,
} = Astro.props;

const kadr = mediaFor(klucz, alt);
const klasy = [kadr.class, className].filter(Boolean).join(' ') || undefined;
---

<SmartImage
  src={kadr.src}
  alt={kadr.alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  quality={kadr.quality}
  class={klasy}
>
  {
    credit && kadr.game && kadr.gameCredit && (
      <Fragment slot="podpis">
        <a href={kadr.gameCredit.source} target="_blank" rel="noopener nofollow">
          {kadr.gameCredit.game}
        </a>
      </Fragment>
    )
  }
  {
    credit && !kadr.game && kadr.src && kadr.photoCredit && (
      <Fragment slot="podpis">
        <a href={kadr.photoCredit.source} target="_blank" rel="noopener nofollow">
          {kadr.photoCredit.author}
        </a>
        {kadr.photoCredit.licenseUrl ? (
          <a
            href={kadr.photoCredit.licenseUrl}
            target="_blank"
            rel="noopener nofollow license"
          >
            {kadr.photoCredit.license}
          </a>
        ) : (
          <span>{kadr.photoCredit.license}</span>
        )}
      </Fragment>
    )
  }
  <EraSkyline slot="zapas" era={era ?? 'jerozolima'} class={className} />
</SmartImage>
