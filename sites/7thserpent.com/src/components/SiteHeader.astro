---
/**
 * Шапка этого сайта. Файл существует, чтобы `Base.astro` оставался при самом
 * `<SiteHeader />`, а данные меню, знак, подписи и иконки жили по эту
 * сторону границы. Механизм — в ядре: `@factory/core/chrome/SiteHeader.astro`.
 * Здесь нет <style> и не должно быть: каждое правило `.hdr*` относится
 * к элементу, который рисует ядро.
 *
 * Формы поиска нет намеренно: `searchAction` в ядре необязателен, без адреса
 * нет обеих форм; поиск приходит со своей страницей.
 *
 * Знак — собственный рисунок сайта «Семёрка из трассы» (сессия 11, П83
 * и дополнение), `Znak.astro`; символика издателя под запретом (PRODUCT.md).
 * В ссылке ядра рисунок немой, имя несёт подпись ссылки: видимое имя знака
 * «7th Serpent» стоит в ней первым (WCAG 2.5.3 — видимая подпись входит
 * в доступное имя), затем домен.
 */
import CoreSiteHeader from '@factory/core/chrome/SiteHeader.astro';
import Znak from './Znak.astro';
import { site, nav } from '../data/site';
---

<CoreSiteHeader items={nav} brandLabel={`${site.znak} — ${site.name}, home`} navLabel="Main" burgerLabel="Menu">
  <Znak slot="znak" />
  <svg slot="ikona-menu" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <svg slot="ikona-zamknij" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
</CoreSiteHeader>
