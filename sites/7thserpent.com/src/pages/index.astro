---
/**
 * Главная — временная страница каркаса (сессия 3, П62).
 *
 * Заголовок и описание здесь литералы, а не `getPage('/')` из структуры:
 * при пустом дереве (`pages: []`) страницы `/` в `structure.json` нет, и
 * `getPage` бросил бы. Это временное отступление от П24 п. 3; с деревом S2
 * страница читает h1/title/description из структуры, как первый сайт.
 *
 * Ровно один <h1> на странице печатает страница (ROLES.md §1) — это
 * проверяет сторож `after-build` ядра на каждой сборке.
 */
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`${site.name} — ${site.tagline}`} description="An unofficial fan site about the Max Payne games. Under construction.">
  <section class="section">
    <div class="container">
      <h1 class="t-headline">An unofficial Max Payne fan site</h1>
      <p class="t-lead measure">
        An unofficial fan site about the Max Payne games, written from a player's point of view.
        Under construction.
      </p>
    </div>
  </section>
</Base>

<style>
  .t-lead {
    margin-top: var(--space-md);
    color: var(--ink-muted);
  }
</style>
