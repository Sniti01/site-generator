---
/**
 * Pierwszy ekran: punkt widokowy. Sylwetka stoi na belce, za nią tarcza
 * zachodzącego słońca, w dole miasto we mgle. Proporcje ludzkie: głowa to
 * mniej więcej jedna siódma postaci, inaczej sylwetka czyta się jak kloc.
 * viewBox celowo bliski proporcjom panelu, żeby slice prawie nie przycinał.
 */
interface Props {
  class?: string;
  /** Pod spodem leży fotografia: własne niebo i miasto z rysunku odpadają,
   *  zostają tarcza, sylwetka, belka i wieża. */
  bare?: boolean;
}
const { class: className, bare = false } = Astro.props;
const near = '#070605';
---

<div class:list={['viewpoint', className]} aria-hidden="true">
  <svg viewBox="0 0 1000 920" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id="vp-sky" x1="0.3" y1="0" x2="0.7" y2="1">
        <stop offset="0%" stop-color="#251611" />
        <stop offset="54%" stop-color="#1a1210" />
        <stop offset="100%" stop-color="#0d0c0a" />
      </linearGradient>
      <radialGradient id="vp-disc" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#e0553f" stop-opacity="0.55" />
        <stop offset="55%" stop-color="#c9622f" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#b08d57" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="vp-haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#b08d57" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#0d0c0a" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="vp-floor" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#0d0c0a" stop-opacity="0" />
        <stop offset="62%" stop-color="#0d0c0a" stop-opacity="0.72" />
        <stop offset="100%" stop-color="#0d0c0a" stop-opacity="1" />
      </linearGradient>
    </defs>

    {!bare && <rect width="1000" height="920" fill="url(#vp-sky)" />}

    <!-- tarcza: sylwetka czyta się na niej, nie na tle -->
    <circle cx="620" cy="520" r="262" fill="url(#vp-disc)" />
    <circle cx="620" cy="520" r="158" fill="#d2582f" opacity="0.15" />

    {!bare && (
      <>
    <!-- miasto w dole, dwa pasma mgły -->
    <g fill="#b08d57" opacity="0.22">
      <path
        d="M0 796h68v-42h50v42h92v-66h56v66h110v-36h56v36h104v-58h58v58h126v-48h54v48h134v-34h46v34h58v82H0z"
      ></path>
    </g>
    <g fill="#b08d57" opacity="0.13">
      <path
        d="M0 748h92v-52h54v52h104v-78h58v78h124v-44h56v44h116v-66h56v66h138v-52h52v52h112v54H0z"
      ></path>
    </g>
    <rect y="700" width="1000" height="200" fill="url(#vp-haze)" />
      </>
    )}

    <!-- ptaki -->
    <g fill={near} opacity="0.7">
      <path d="M188 196c26-21 52-24 73-10 21-14 47-11 73 10-26-5-49 3-73 16-24-13-47-21-73-16z"></path>
      <path d="M258 202h5l-2 12h-3z"></path>
    </g>
    <g fill={near} opacity="0.38">
      <path d="M836 292c15-11 30-13 41-5 11-8 26-6 41 5-15-2-28 2-41 9-13-7-26-11-41-9z"></path>
    </g>

    <!-- belka i wieża -->
    <g fill={near}>
      <path d="M470 641h342v16H470z"></path>
      <path d="M470 657h26l12 22h-22zM786 657h26l-18 22h-22z"></path>
      <path d="M584 657h72l14 263H570z"></path>
      <path d="M584 657h12v-16h-12zM606 657h12v-16h-12zM628 657h12v-16h-12zM650 657h12v-16h-12z"></path>
      <path d="M566 720h108v8H566zM560 802h120v8H560zM554 876h132v8H554z"></path>
      <path d="M612 657h22v263h-22z" opacity="0.2"></path>
    </g>

    <!-- sylwetka. Wszystko jest tą samą czernią, więc ramię, krawędź płaszcza
         i kaptur czytają się światłem konturowym od tarczy, nie odcieniem. -->
    <g transform="translate(620 641) scale(1.32) translate(-620 -641)">
      <path
        d="M621 468c-12 0-20 9-20 21l-2 10-11 4 12 5-3 10-22 106c10 4 20 5 30 2 12 4 24 4 36 0 9 3 18 3 26 0l-22-106-3-10c6-26 6-40-21-40z"
        fill={near}
      ></path>
      <g fill={near}>
        <path d="M603 626h15l2 19h-18zM628 626h15l-1 19h-17z"></path>
        <path d="M597 643h23v11h-23zM624 643h23v11h-23z"></path>
      </g>
      <g fill="none" stroke="#e8734f" stroke-linecap="round">
        <path
          d="M621 468c-12 0-20 9-20 21l-2 10-11 4 12 5-3 10-22 106"
          stroke-width="1.7"
          opacity="0.4"
        ></path>
        <path d="M642 511c14 33 21 72 19 111" stroke-width="1.7" opacity="0.34"></path>
        <path d="M604 515c-6 18-5 35 2 49" stroke-width="1.3" opacity="0.22"></path>
        <path d="M601 512c11 5 23 6 34 2" stroke-width="1.2" opacity="0.18"></path>
        <path d="M605 489c9 4 18 4 25-1" stroke-width="1.2" opacity="0.2"></path>
      </g>
      <path d="M594 556l-4 19" stroke="#f6a071" stroke-width="2.1" opacity="0.5" stroke-linecap="round"></path>
    </g>

    <rect y="806" width="1000" height="114" fill="url(#vp-floor)" />
  </svg>
</div>

<style>
  .viewpoint {
    position: absolute;
    inset: 0;
  }

  .viewpoint svg {
    width: 100%;
    height: 100%;
  }
</style>
