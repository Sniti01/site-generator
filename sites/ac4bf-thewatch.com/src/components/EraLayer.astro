---
import { stronaEpoki, rodzaj, type Era } from '../data/site';
import { getPage } from '../lib/structure';
import StoryRow from '@factory/core/blocks/StoryRow.astro';
import LinkList from '@factory/core/blocks/LinkList.astro';
import EraMedia from './EraMedia.astro';
import Icon from './Icon.astro';

/**
 * Warstwa zejścia: jedna epoka serii. Plik istnieje po to, żeby `index.astro`
 * zostało przy samym `<EraLayer />`, a wszystko, co należy do witryny —
 * słownik epok i ich paleta, nadtytuł w roli `t-year` (rdzeń jej nie zna),
 * wiersz metadanych z własną interpunkcją, tekst i pergaminowa tabliczka —
 * mieszkało po tej stronie granicy.
 *
 * Mechanizm rzędu jest w rdzeniu: `@factory/core/blocks/StoryRow.astro`,
 * lista poradników — `@factory/core/blocks/LinkList.astro`.
 *
 * DLACZEGO TABLICZKA MA `:global`, a reszta nie. Sekcję rysuje
 * rdzeń, więc niesie ona JEGO skrót `data-astro-cid-*`; reguła zapisana tutaj
 * zwyczajnie dostałaby skrót tego pliku i po cichu przestałaby pasować
 * (`docs/REUSE.md` §1.1, przypis ²). Pięć reguł palety `.layer--<epoka>`
 * z tego samego powodu było tu `:global` — a od 2026-09-12 (П44, punkt 33)
 * mieszka w `src/styles/global.css`: `:global` w komponencie nie dociera do
 * stron, które komponentu nie drukują. Przy tabliczce globalny jest sam PRZODEK — `:global(.layer--flip)
 * .layer__plate` — bo skrót zostaje na tabliczce, którą rysuje ten plik;
 * forma zmierzona kompilatorem przed wynoszeniem (raport 2026-09-09).
 * Odwrotna forma, `:global` na potomku, jest zakazana: obniżyłaby swoistość
 * pierwszego członu grupy i tabliczka po cichu przestałaby się centrować.
 *
 * Pozostałe reguły — nadtytuł, meta, tekst, tabliczka i jej dwa akapity —
 * zwyczajne: te elementy rysuje ten plik, więc noszą jego skrót. Elementy
 * wewnątrz `<Fragment slot="…">` też noszą skrót OWIJKI, nie rdzenia.
 */
interface Props {
  era: Era;
  flip: boolean;
  band: boolean;
}

const { era, flip, band } = Astro.props;

/**
 * Lista w warstwie: adresy z `site.ts`, tytuły i dopiski ZE STRUKTURY.
 * `getPage` przerywa budowanie na adresie spoza drzewa — to bramka przeciw
 * widmom, których do 2026-09-11 stało tu piętnaście (odpowiedź właściciela 3а).
 * Ikona zegara zdjęta razem z minutami czytania: dopisek to teraz typ strony.
 */
const pozycje = era.guides.map((guide) => {
  const cel = getPage(guide.href);
  return { href: guide.href, title: cel.h1, meta: rodzaj[cel.type] ?? cel.type };
});
---

<StoryRow
  title={era.headline}
  titleId={`epoka-${era.id}-tytul`}
  id={`epoka-${era.id}`}
  modifier={`layer--${era.id}`}
  flip={flip}
  band={band}
  attrs={{ 'data-era-section': era.id }}
>
  <p class="layer__year t-year" slot="nadtytul">{era.year}</p>

  <Fragment slot="meta">
    {era.place} · {era.span} · <span class="layer__hero">{era.hero}</span>
  </Fragment>

  <Fragment slot="body">{era.body}</Fragment>

  <Fragment slot="tresc">
    {
      /* Epoka bez innych stron w drzewie (Japonia, Londyn) dostaje sam
         link do gry — `.btn-link` to klasa szasi, ta sama, którą drukuje
         `LinkList`; pusty `<ul>` nie jest drukowany. */
      pozycje.length > 0 ? (
        <LinkList items={pozycje} allHref={stronaEpoki[era.id]} allLabel="Strona gry z tej epoki">
          <Icon slot="ikona-wszystkie" name="strzalka-w-prawo" size={18} />
        </LinkList>
      ) : (
        <a class="btn-link t-button" href={stronaEpoki[era.id]}>
          Strona gry z tej epoki<Icon name="strzalka-w-prawo" size={18} />
        </a>
      )
    }
  </Fragment>

  <EraMedia
    slot="kadr"
    klucz={era.id}
    era={era.id}
    widths={[640, 960, 1280]}
    sizes="(max-width: 1024px) 92vw, 46vw"
    credit={false}
  />

  <div class="layer__plate" slot="tabliczka">
    <p class="layer__plate-game t-title">{era.game}</p>
    <p class="layer__plate-meta t-caption tabular">Premiera {era.released}</p>
  </div>
</StoryRow>

<style>
  /* Pięć reguł palety `.layer--<epoka>` mieszkało tu jako `:global` do
     2026-09-12 (П44, punkt 33). `:global` w `<style>` komponentu daje regułę
     bez skrótu, ale TYLKO w chunku CSS strony, na której komponent jest
     wydrukowany — głównej; trasa tego chunku nie ładuje i `layer--karaiby`
     na stronie gry nie robiło nic. Reguły przeniesione do
     `src/styles/global.css`, obok `.layer__year` — tą samą drogą, co krok 5б. */

  /* `.layer__meta` и `.layer__body` уехали в ядро шагом Г1: их отступ — ритм
     блока, а цвет выражен токеном договора. Здесь остаётся только то, что
     красит эпоха. */
  .layer__hero {
    color: var(--era-text);
  }

  .layer__plate {
    position: relative;
    z-index: 1;
    max-width: 330px;
    margin-top: calc(var(--space-2xl) * -1);
    margin-inline-start: var(--space-xl);
    padding: var(--space-md);
    /* Papier, nie swatch: włókno w tle, nierówna krawędź dolna, oddzielenie
       kreską wtopioną w arkusz zamiast rozmytego cienia pod prostokątem. */
    background-color: var(--parchment);
    background-image:
      repeating-linear-gradient(
        96deg,
        transparent 0 3px,
        rgb(30 25 19 / 0.028) 3px 4px
      ),
      repeating-linear-gradient(
        6deg,
        transparent 0 7px,
        rgb(30 25 19 / 0.02) 7px 8px
      );
    color: var(--ink-parchment);
    border-radius: var(--radius-none);
    box-shadow: inset 0 0 0 1px rgb(30 25 19 / 0.16);
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 5px),
      88% 100%,
      74% calc(100% - 4px),
      58% calc(100% - 1px),
      41% calc(100% - 5px),
      27% 100%,
      12% calc(100% - 3px),
      0 calc(100% - 6px)
    );
  }

  :global(.layer--flip) .layer__plate {
    margin-inline: auto var(--space-xl);
  }

  .layer__plate-game {
    color: var(--ink-parchment);
    text-wrap: balance;
  }

  .layer__plate-meta {
    margin-top: var(--space-3xs);
    color: var(--ink-parchment-muted);
  }

  @media (max-width: 1024px) {
    .layer__plate,
    :global(.layer--flip) .layer__plate {
      margin-inline: var(--space-md) auto;
    }
  }

  @media (max-width: 560px) {
    .layer__plate,
    :global(.layer--flip) .layer__plate {
      margin-inline: 0;
      max-width: none;
    }
  }
</style>
