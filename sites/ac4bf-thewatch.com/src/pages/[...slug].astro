---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/structure';
import slownik from '@factory/core/structure/blocks.json';
import HeroKeyArt from '@factory/core/blocks/HeroKeyArt.astro';
import StoryRow from '@factory/core/blocks/StoryRow.astro';
import LinkList from '@factory/core/blocks/LinkList.astro';
import CardRail from '@factory/core/blocks/CardRail.astro';
import LinkColumns from '@factory/core/blocks/LinkColumns.astro';
import CtaBand from '@factory/core/blocks/CtaBand.astro';
import Byline from '@factory/core/blocks/Byline.astro';
import Toc from '@factory/core/blocks/Toc.astro';
import Gallery from '@factory/core/blocks/Gallery.astro';
import VerdictBox from '@factory/core/blocks/VerdictBox.astro';
import { mediaFor } from '../data/media';
import EraMedia from '../components/EraMedia.astro';
import Icon from '../components/Icon.astro';
import type { EraId } from '../data/site';

/**
 * Jedna trasa dla całej treści fali 1. Adres bierze się z pola `url` we front
 * matterze, a `getPage` sprawdza go przy budowaniu: strona spoza
 * `structure.json` wywala build (П24 punkt 1, rozwidlenie 1).
 *
 * Tytuł, opis i h1 idą ze struktury, nie z pliku treści (П24 punkt 3).
 * Kolejność sekcji też: mówi ją `blocks[]`. Z pliku treści przychodzą
 * wyłącznie zdania i adresy.
 *
 * BLOKI JESZCZE NIEZROBIONE POMIJA SIĘ GŁOŚNO. Które są gotowe, mówi pole
 * `реализован` w `core/structure/blocks.json` — nie lista w tym pliku.
 * Każdy pominięty blok jest wypisywany po imieniu przy budowaniu: cicha
 * zaślepka jest tu zakazana, bo strona z brakiem wygląda tak samo jak strona
 * bez braku. `byline`, `toc`, `gallery` i `verdict-box` wchodzą w sesji 6,
 * i ta sama strona jest jej stendem (П29 punkt 2).
 *
 * DLACZEGO STRONA GŁÓWNA TU NIE MIESZKA. Jej pięć pól w strukturze różni się
 * od tego, co drukuje `index.astro` — łącznie z widocznym `h1`, który trzyma
 * piksel `_baseline/`. Przeprowadzka głównej jest czwartym punktem П32
 * i jedzie razem z jedyną przesiadką wzorca.
 */
/**
 * ГДЕ ТЕПЕРЬ ГРАНИЦА ПЕЧАТИ (шаг 5б, П34). Маршрут больше не печатает абзацы
 * блоков сам: лид, мету и тело печатает ядро, а сюда приходят только зёрна —
 * текст и адреса. До 5б маршрут печатал их своими `<p>`, они несли ЕГО скрут,
 * и правила ядра на них не совпадали: страница получала разметку без вида.
 * Стена скрутов односторонняя — П34, третья строка уточнения.
 */
export async function getStaticPaths() {
  const wpisy = await getCollection('tresc');
  return wpisy.map((wpis) => {
    getPage(wpis.data.url); // bramka: adres spoza struktury przerywa budowanie
    return {
      params: { slug: wpis.data.url.replace(/^\/|\/$/g, '') },
      props: { wpis },
    };
  });
}

const { wpis } = Astro.props;
const strona = getPage(wpis.data.url);
const dane = wpis.data;

const gotowy = (imie: string) =>
  Boolean((slownik as { блоки: Record<string, { реализован?: boolean }> }).блоки[imie]?.реализован);

/**
 * WYSTĄPIENIE, NIE NAZWA. `blocks[]` wolno wymienić ten sam blok dwa razy,
 * jeśli wystąpienia różni pole `role` — umowa już to dopuszcza i już z tego
 * korzysta: `/ezio-auditore/` ma dwie taśmy (`type-default` i `manual`
 * z `role: the-ezio-collection`), a główna ma `link-list` z `role`.
 * Klucz `nazwa#role` jest tu jedyną tożsamością bloku na stronie.
 */
const kluczOd = (b: { block: string; role?: string }) => (b.role ? `${b.block}#${b.role}` : b.block);
const wystapienia = strona.blocks as { block: string; role?: string }[];
const pominiete = wystapienia.filter((b) => !gotowy(b.block)).map(kluczOd);
const doZrobienia = wystapienia.filter((b) => gotowy(b.block)).map(kluczOd);

if (pominiete.length) {
  console.log(`  ${strona.url} — bloki zadeklarowane, ale nie w rdzeniu: ${pominiete.join(', ')}`);
}

/**
 * `link-list` niesie pole `related` ze struktury, a nie z pliku treści.
 * Od 2026-09-10 jest zadeklarowany w `blocks[]` wszystkich trzydziestu stron
 * (decyzja właściciela, wariant „b"), więc dawne pytanie z raportu sesji 5 —
 * czy ma być deklarowany — jest zamknięte.
 */
const pokrewne = (strona.related ?? []).map((url) => {
  const cel = getPage(url);
  return { href: url, title: cel.h1, meta: cel.type === 'game' ? 'Gra' : 'Tekst' };
});

/** Taśmy z pliku treści, dopasowywane do wystąpień po `role`. */
const tasmy = dane.cards ?? [];
const tasmaDla = (role?: string) => tasmy.find((t) => (t.role ?? undefined) === role);

/**
 * CZY STRONA MA CZYM WYPEŁNIĆ BLOK — po jednym predykacie na nazwę. Te same
 * predykaty stoją w warunkach druku niżej: lista i rozmieszczenie liczą się
 * z jednego źródła, więc nie mogą się rozejść.
 */
const maTresc: Record<string, (role?: string) => boolean> = {
  'hero-key-art': () => true, // schemat treści wymaga `lead`, `primary` i `secondary`
  byline: () => Boolean(dane.byline),
  toc: () => Boolean(dane.toc),
  'story-row': () => (dane.rows ?? []).length > 0,
  'card-rail': (role) => Boolean(tasmaDla(role)),
  gallery: () => Boolean(dane.gallery),
  'link-columns': () => Boolean(dane.columns),
  'verdict-box': () => Boolean(dane.verdict),
  'link-list': () => pokrewne.length > 0 && Boolean(dane.related),
  'cta-band': () => Boolean(dane.cta),
};

/**
 * Kolejność drukowana niżej jest wpisana ręcznie, więc musi być pilnowana
 * maszyną, a nie pamięcią. `PORZADEK` mówi jedno: w jakiej kolejności bloki
 * wolno drukować. Ustalony 2026-09-10 sortowaniem topologicznym po `blocks[]`
 * wszystkich 29 stron trasy — porządek spójny istnieje i jest jeden.
 * `band-quote` go nie ma celowo: na trasie nie występuje ani razu, stoi tylko
 * na głównej. Główna wjeżdża na trasę czwartym punktem П32 i przyniesie ze
 * sobą DWA konflikty kolejności (`link-list` przed `gallery` i przed
 * `link-columns`) — jedyne dwa w całym drzewie. Wtedy albo `blocks[]` głównej
 * się porządkuje, albo szablon dostaje prawdziwego dyspozytora; dopóki
 * główna ma własną stronę, wybierać nie ma czego.
 */
const PORZADEK = [
  'hero-key-art',
  'byline',
  'toc',
  'story-row',
  'card-rail',
  'gallery',
  'link-columns',
  'verdict-box',
  'link-list',
  'cta-band',
];

/**
 * CO SZABLON NAPRAWDĘ WYDRUKUJE — i to jest ta lista, której sprawdzenie
 * dotąd nie miało. Do 2026-09-10 porównywano `blocks[]` z `blocks[]`
 * przefiltrowanym: obie strony równania pochodziły z deklaracji, więc druk
 * nie był pilnowany NIGDY. Blok drukowany bezwarunkowo — a taki był
 * `hero-key-art` — przechodził przez to sprawdzenie niewidzialny.
 * Teraz każdy warunek druku niżej brzmi `drukowane.includes(klucz)`, więc
 * lista i rozmieszczenie mają jedno źródło, a rozejście przerywa budowanie.
 */
const drukowane = PORZADEK.flatMap((nazwa) =>
  wystapienia
    .filter((b) => b.block === nazwa && gotowy(nazwa) && (maTresc[nazwa]?.(b.role) ?? false))
    .map(kluczOd)
);

if (doZrobienia.join(',') !== drukowane.join(',')) {
  const brakujace = doZrobienia.filter((k) => !drukowane.includes(k));
  throw new Error(
    `Blocks[] i druk rozeszły się na ${strona.url}.\n` +
      `  struktura deklaruje i rdzeń umie: ${doZrobienia.join(', ') || '—'}\n` +
      `  szablon wydrukuje:                ${drukowane.join(', ') || '—'}\n` +
      (brakujace.length
        ? `  bez treści albo bez miejsca w PORZADEK: ${brakujace.join(', ')}\n`
        : '  rozeszła się sama kolejność\n') +
      'Popraw treść, szablon albo strukturę — ale nie zostawiaj rozejścia.'
  );
}
---

<Base title={strona.title} description={strona.description} skala={false}>
  {
    /* Do 2026-09-10 hero drukował się BEZWARUNKOWO, a sześć stron fali 1 go
       nie deklaruje. To ten sam defekt, co podwójne linki: szablon drukował,
       czego umowa nie zamawiała. Teraz warunek jest taki sam jak u reszty. */
    drukowane.includes('hero-key-art') && (
      <HeroKeyArt
        title={strona.h1}
        titleId="strona-tytul"
        primaryHref={dane.primary.href}
        primaryLabel={dane.primary.label}
        secondaryHref={dane.secondary.href}
        secondaryLabel={dane.secondary.label}
      >
        {dane.art && (
          <EraMedia
            slot="art"
            klucz={dane.art as EraId}
            widths={[1200, 1600, 2400, 3200]}
            sizes="(max-width: 1024px) 200vw, 170vw"
            loading="eager"
            credit={false}
          />
        )}
        <Fragment slot="lead">{dane.lead}</Fragment>
        <Icon slot="ikona-glowna" name="w-dol" size={18} />
      </HeroKeyArt>
    )
  }

  {
    drukowane.includes('byline') && dane.byline && (
      <Byline
        author={dane.byline.author}
        date={dane.byline.date}
        dateLabel={dane.byline.dateLabel}
        role={dane.byline.role}
      />
    )
  }

  {drukowane.includes('toc') && dane.toc && <Toc items={dane.toc.items} title={dane.toc.title} titleId="toc-tytul" />}

  {
    drukowane.includes('story-row') &&
    dane.rows.map((rzad) => (
      <StoryRow
        title={rzad.title}
        titleId={`${rzad.id}-tytul`}
        id={rzad.id}
        modifier={`layer--${dane.art ?? 'karaiby'}`}
        flip={rzad.flip}
        band={rzad.band}
      >
        <p class="layer__year t-year" slot="nadtytul">
          {rzad.year}
        </p>

        <Fragment slot="meta">{rzad.meta}</Fragment>

        <Fragment slot="body">
          {rzad.body.map((akapit) => (
            <p>{akapit}</p>
          ))}
        </Fragment>

        {
          rzad.art && (
            <EraMedia
              slot="kadr"
              klucz={rzad.art as EraId}
              era={rzad.art as EraId}
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 92vw, 46vw"
              credit={false}
            />
          )
        }
      </StoryRow>
    ))
  }

  {
    /* JEDYNY BLOK DRUKOWANY W PĘTLI PO WYSTĄPIENIACH, i to nie zapas na
       przyszłość: `/ezio-auditore/` deklaruje dwie taśmy — bezpodstawną
       `type-default` i świadomą `manual` z `role: the-ezio-collection`.
       Treść dopasowuje się po `role`, więc druga taśma dostaje swoje karty,
       a nie kopię pierwszej. Strony `game` od 2026-09-10 taśmy nie deklarują
       wcale (punkt 20 backlogu), więc pętla jest u nich pusta. */
    wystapienia
      .filter((b) => b.block === 'card-rail' && drukowane.includes(kluczOd(b)))
      .map((b) => {
        const t = tasmaDla(b.role)!;
        return (
          <CardRail
            cards={t.items}
            title={t.title}
            titleId={b.role ? `dokad-${b.role}-tytul` : 'dokad-tytul'}
            lead={t.lead}
            trackLabel="Sąsiednie części, przewijane poziomo"
            prevLabel="Poprzednie karty"
            nextLabel="Następne karty"
          >
            <Icon slot="ikona-wstecz" name="strzalka-w-lewo" size={20} />
            <Icon slot="ikona-dalej" name="strzalka-w-prawo" size={20} />
            <Icon slot="ikona-wszystkie" name="strzalka-w-prawo" size={18} />
          </CardRail>
        );
      })
  }

  {
    drukowane.includes('gallery') && dane.gallery && (
      <Gallery
        items={dane.gallery.items.map((k) => {
          const m = mediaFor(k.art, k.alt);
          return { src: m.src, alt: k.alt, caption: k.caption, quality: m.quality, class: m.class };
        })}
        title={dane.gallery.title}
        titleId="galeria-tytul"
        lead={dane.gallery.lead}
      />
    )
  }

  {
    /* `link-columns` szablon drukuje od 2026-09-10. Do tej daty blok był
       zadeklarowany na `/poradniki/`, zaimplementowany w rdzeniu i nieznany
       szablonowi naraz — czyli ściana, o którą strona rozbiłaby się przy
       pierwszej treści. Grupy przychodzą polem `columns`, tak jak `catalog`
       przychodzi do `CatalogStack` na głównej. */
    drukowane.includes('link-columns') && dane.columns && (
      <LinkColumns
        groups={dane.columns.groups}
        title={dane.columns.title}
        label={dane.columns.label}
        href={dane.columns.href}
      >
        <Fragment slot="lead">{dane.columns.lead}</Fragment>
        <Icon slot="akcja" name="strzalka-w-prawo" size={18} />
      </LinkColumns>
    )
  }

  {
    drukowane.includes('verdict-box') && dane.verdict && (
      <VerdictBox label={dane.verdict.label} labelId="werdykt-tytul">
        {dane.verdict.body.map((akapit) => (
          <p>{akapit}</p>
        ))}
      </VerdictBox>
    )
  }

  {
    drukowane.includes('link-list') && pokrewne.length > 0 && dane.related && (
      <LinkList items={pokrewne} title={dane.related.title} titleId="powiazane-tytul">
        <Icon slot="ikona-wszystkie" name="strzalka-w-prawo" size={18} />
      </LinkList>
    )
  }

  {
    drukowane.includes('cta-band') && dane.cta && (
      <CtaBand title={dane.cta.title} lead={dane.cta.lead} href={dane.cta.href} label={dane.cta.label} id="cta-tytul">
        <Icon slot="akcja" name="strzalka-w-prawo" size={18} />
      </CtaBand>
    )
  }
</Base>


