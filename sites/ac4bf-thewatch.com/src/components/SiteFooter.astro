---
/**
 * Stopka tej witryny. Plik istnieje po to, żeby `Base.astro` zostało przy
 * samym `<SiteFooter />`, a dane kolumn, znak, polskie zdania i cały dół
 * stopki mieszkały po tej stronie granicy.
 *
 * Szasi jest w rdzeniu: `@factory/core/chrome/SiteFooter.astro`.
 *
 * Dół stopki — noty kredytowe i pasmo prawne — został tutaj w całości,
 * razem ze swoimi regułami, a nie tylko z tekstem. Powód jest mechaniczny:
 * reguła `.ft__legal i` kompiluje się do
 * `.ft__legal[data-astro-cid-X] i[data-astro-cid-X]`, więc skrót musi być
 * na obu elementach. Gdyby `<div class="ft__legal">` został w rdzeniu,
 * a tekst z `<i>` przyszedł slotem, skróty by się rozjechały i reguła
 * przestałaby działać — po cichu.
 */
import CoreSiteFooter from '@factory/core/chrome/SiteFooter.astro';
import Wordmark from './Wordmark.astro';
import { eras, stronaEpoki } from '../data/site';
import type { ArtCredit } from '../data/art';
import artCredits from '../data/art-credits.json';
import gameCredits from '../data/game-art.json';

interface Props {
  /**
   * Klucze artu użyte NA TEJ STRONIE (bohater, rzędy, galeria, karty) —
   * stopka drukuje atrybucje i nazwy gier tylko dla nich. Do 2026-09-15
   * drukowała wszystkie wpisy obu rejestrów na każdej stronie; П57 (odp. 1б):
   * obowiązek atrybucji CC BY wypełnia się tam, gdzie kadr jest pokazany,
   * a nowy kadr na jednej stronie przestaje ruszać stopkę (i wzorce) reszty.
   * Pusta lista — stopka bez bloków kredytowych (strony bez artu: /404/,
   * /prywatnosc/).
   */
  klucze: string[];
}

const { klucze } = Astro.props;
const uzyte = new Set(klucze);

// Atrybucja zdjęć: licencje CC BY i CC BY-SA jej wymagają, a przy miniaturach
// podpis przy kadrze jest nieczytelny — więc zbiorczo, raz, tutaj: te kadry
// Commons, które ta strona pokazuje.
const zdjecia = Object.entries(artCredits as Record<string, ArtCredit>)
  .filter(([klucz]) => uzyte.has(klucz))
  .map(([, wpis]) => wpis);

// Materiały gier nie mają wolnej licencji, więc zamiast listy autorów idzie
// jedna nota o prawach i o tym, po co ich tu używamy — dla gier, których
// kadry ta strona pokazuje. Okładka `<slot>-okladka` nie ma własnego wpisu:
// jej gra jest już nazwana przez kadr tego samego slotu.
const gry = Object.entries(gameCredits as Record<string, { game: string; licencja?: string }>)
  .filter(([klucz]) => uzyte.has(klucz))
  .map(([, wpis]) => wpis);
const tytulyGier = [...new Set(gry.map((item) => item.game))].sort();
// Klasa licencji materiału wydawcy — z kredytów, nie z głowy: każda pozycja
// `game-art.json` niesie to samo zdanie (П42, «Steam — tak»); w stopce idzie
// osobnym wierszem, żeby czytelnik widział, na jakich warunkach jest art.
const klasyLicencji = [...new Set(gry.map((item) => item.licencja).filter((x): x is string => Boolean(x)))];

const kolumny = [
  // Cztery adresy pierwszej kolumny i `/epoki/<id>/` w drugiej były drugą
  // schematyką nawigacji, której w drzewie nie ma — П27 punkt 3. Zastąpione
  // adresami z drzewa. Że większość z nich jeszcze nie jest zbudowana, to inna
  // sprawa: adres planowany różni się od adresu widmo.
  {
    title: 'Guides',
    links: [
      { label: 'Where to start', href: '/guides/where-to-start/' },
      { label: 'All guides', href: '/guides/' },
      // «Film Rodowód» — jak w menu (П44, punkt 35): strona jest o filmie Lineage;
      // stopka wyrównana do menu 2026-09-15 (П50, punkt 39) — jeden adres, jedna nazwa.
      { label: 'Lineage film', href: '/assassins-creed-lineage/' },
      { label: 'Historical locations map', href: '/historical-locations-map/' },
    ],
  },
  {
    title: 'Eras',
    links: eras.map((era) => ({ label: `${era.year} · ${era.place}`, href: stronaEpoki[era.id] })),
  },
  {
    title: 'Site',
    // Trzy adresy zdjęte 2026-09-11 (odpowiedź właściciela «podwał: a», П41):
    // `/o-nas/`, `/redakcja/`, `/kontakt/` nie istnieją w drzewie fali 1
    // i nie są zbudowane — link-widmo w stopce każdej strony. Wrócą razem
    // ze swoimi stronami. `Polityka prywatności` zostaje: to obietnica,
    // nie link — jej strona idzie wczesnym punktem kolejki tekstów fali 1,
    // do tego dnia jedyny adres-widmo w serwisie jest nazwany tutaj.
    links: [{ label: 'Privacy policy', href: '/privacy/' }],
  },
];
---

<CoreSiteFooter columns={kolumny}>
  <Wordmark slot="znak" size="lg" />
  <Fragment slot="pitch">
        We write about the series from the player’s side: where to go, what to take and what you can’t afford to miss.
      </Fragment>

  <Fragment slot="dol">{
    tytulyGier.length > 0 && (
      <div class="ft__foto">
        <div class="container">
          <h2 class="ft__foto-title t-label">Artwork</h2>
          <p class="ft__foto-note t-caption">
            Key art and screenshots come from the games’ Steam store pages and remain the
            property of <strong>Ubisoft Entertainment</strong>. They are used solely to
            identify the games in the series that the site’s pages are about. The site does not
            use the publisher’s logos in its own identity. Games: {tytulyGier.join(', ')}.
          </p>
          {klasyLicencji.length > 0 && (
            <p class="ft__foto-note t-caption">
              License class: {klasyLicencji.join('; ')}.
            </p>
          )}
        </div>
      </div>
    )
  }

  {
    zdjecia.length > 0 && (
      <div class="ft__foto">
        <div class="container">
          <h2 class="ft__foto-title t-label">Photos</h2>
          <ul class="ft__foto-list t-caption">
            {zdjecia.map((foto) => (
              <li>
                <a href={foto.source} target="_blank" rel="noopener nofollow">
                  {foto.title}
                </a>
                {' — '}
                {foto.author}
                {', '}
                {foto.licenseUrl ? (
                  <a href={foto.licenseUrl} target="_blank" rel="noopener nofollow license">
                    {foto.license}
                  </a>
                ) : (
                  foto.license
                )}
              </li>
            ))}
          </ul>
          <p class="ft__foto-note t-caption">
            The photos come from Wikimedia Commons and are used under their respective
            licenses; their cropping and color have been changed.
          </p>
        </div>
      </div>
    )
  }

  <div class="ft__legal">
    <div class="container ft__legal-inner">
      <p class="t-caption">
        An unofficial site, not affiliated with the publisher. <i>Assassin’s Creed</i> and the
        game titles belong to their owners and are used solely to describe what these guides
        are about. No publisher logos, typefaces or colors.
      </p>
      <p class="t-caption ft__copy tabular">© 2026 The Brotherhood</p>
    </div>
  </div></Fragment>
</CoreSiteFooter>

<style>
  .ft__foto {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-lg);
    color: var(--ink-muted);
  }

  .ft__foto-title {
    color: var(--ink);
  }

  .ft__foto-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3xs) var(--space-lg);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .ft__foto-list a {
    color: inherit;
  }

  .ft__foto-list a:hover {
    color: var(--ink);
  }

  .ft__foto-note {
    margin-top: var(--space-md);
  }

  .ft__legal {
    border-top: 1px solid var(--hairline);
  }

  .ft__legal-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    color: var(--ink-muted);
  }

  .ft__legal i {
    font-style: normal;
    color: var(--ink);
  }

  .ft__copy {
    flex: none;
  }

  @media (max-width: 900px) {
    .ft__foto-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .ft__legal-inner {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
