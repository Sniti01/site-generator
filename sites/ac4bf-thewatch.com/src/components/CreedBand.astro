---
/**
 * Pauza tej witryny: maksyma serii i trzy stulecia, w których znaczyła co
 * innego. Plik istnieje po to, żeby `index.astro` zostało przy samym
 * `<CreedBand />`, a polskie zdania i ornament-romb mieszkały po tej stronie
 * granicy.
 *
 * Mechanizm pasma jest w rdzeniu: `@factory/core/blocks/BandQuote.astro`.
 * Tutaj zostaje ornament i reguła, która nadaje mu rozmiar i kolor — muszą
 * być w jednym komponencie, bo `data-astro-cid-*` wiąże regułę z elementem
 * po skrócie.
 */
import BandQuote from '@factory/core/blocks/BandQuote.astro';
---

<BandQuote>
  <svg slot="ornament" class="creed__ornament" viewBox="0 0 220 44" aria-hidden="true" focusable="false">
    <path
      d="M4 22h74M142 22h74"
      stroke="currentColor"
      stroke-width="1.4"
      opacity="0.7"
      stroke-linecap="round"></path>
    <path d="M110 4 128 22 110 40 92 22z" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    <path d="M110 12 120 22 110 32 100 22z" fill="currentColor"></path>
  </svg>

  <Fragment slot="cytat">
      Nic nie jest prawdziwe,<br />wszystko jest dozwolone
    </Fragment>

  <Fragment slot="tresc">
      Maksyma, którą seria powtarza od 2007 roku i za każdym razem rozumie inaczej. Poniżej trzy
      stulecia, w których znaczyła co innego.
    </Fragment>
</BandQuote>

<style>
  .creed__ornament {
    width: 220px;
    height: 44px;
    margin: 0 auto var(--space-lg);
    color: var(--accent-2);
  }
</style>
