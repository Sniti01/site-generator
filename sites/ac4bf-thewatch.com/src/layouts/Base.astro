---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DescentRail from '../components/DescentRail.astro';
import Grain from '@factory/core/effects/Grain.astro';

interface Props {
  title: string;
  description: string;
  /** Czy drukować skalę po lewej. Brak — tak. Strony gier jej nie mają: П35
   *  w redakcji z 2026-09-10, po odbiorze okiem. */
  skala?: boolean;
}

const { title, description, skala } = Astro.props;
const zeSkala = skala !== false;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class={zeSkala ? undefined : 'bez-skali'}>
    <a class="skip-link t-button" href="#tresc">Przejdź do treści</a>
    {zeSkala && <DescentRail />}
    <SiteHeader />
    <main id="tresc">
      <slot />
    </main>
    <SiteFooter />
    <Grain />

    <style is:global>
      /* Skala zejścia zajmuje lewą krawędź — treść ustępuje jej miejsca.
         KLASA WISI NA BRAKU, nie na obecności: dzięki temu wydruk strony
         głównej nie zmienia się ani o bajt, a stronа bez skali odbiera
         sobie żłób z powrotem. */
      @media (min-width: 1200px) {
        body {
          padding-left: var(--rail);
        }
        body.bez-skali {
          padding-left: 0;
        }
      }

      html.menu-otwarte {
        overflow: hidden;
      }
    </style>
  </body>
</html>
