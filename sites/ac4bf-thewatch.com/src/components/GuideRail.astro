---
import CardRail from '@factory/core/blocks/CardRail.astro';
import Icon from './Icon.astro';
import { fresh, eras } from '../data/site';
import { mediaFor } from '../data/media';

/**
 * Taśma świeżych tekstów. Mechanizm jest w rdzeniu:
 * `@factory/core/blocks/CardRail.astro` — nagłówek, strzałki, przewijana
 * ścieżka ze snapem i skrypt. Tutaj zostaje to, czego rdzeń wiedzieć nie może:
 * dane wpisów, polskie napisy, adresy, ikony i paleta epok.
 *
 * KARTY IDĄ DANYMI, nie znacznikiem — slot nie powiela zawartości, a kart
 * w taśmie jest tyle, ile wpisów. Kadr każdej karty rozstrzyga się tutaj,
 * przez `mediaFor`, i jedzie do rdzenia gotowym `ImageMetadata` (umowa П4).
 *
 * REGUŁY PALETY SĄ `:global` I MUSZĄ TAKIE BYĆ. `<li>` rysuje rdzeń, więc
 * nosi jego skrut `data-astro-cid-*`; reguła zapisana zwyczajnie dostałaby
 * skrut tego pliku i po cichu przestałaby działać. Sama paleta zostaje
 * po stronie witryny: nazwy epok to jej słownik, nie słownik fabryki.
 */
const eraName = new Map(eras.map((era) => [era.id, era.place]));

const cards = fresh.map((item) => {
  const kadr = mediaFor(item.era);
  return {
    href: item.href,
    title: item.title,
    date: item.date,
    dateLabel: item.dateLabel,
    kind: item.kind,
    place: eraName.get(item.era),
    modifier: `rail-sec__item--${item.era}`,
    media: kadr.src
      ? { src: kadr.src, alt: kadr.alt, quality: kadr.quality, class: kadr.class }
      : undefined,
  };
});
---

<CardRail
  cards={cards}
  title="Świeżo z Animusa"
  titleId="swieze-tytul"
  lead="Ostatnie teksty, niezależnie od epoki."
  trackLabel="Świeże teksty, przewijane poziomo"
  prevLabel="Poprzednie karty"
  nextLabel="Następne karty"
  allHref="/poradniki/"
  allLabel="Wszystkie poradniki"
>
  <Icon slot="ikona-wstecz" name="strzalka-w-lewo" size={20} />
  <Icon slot="ikona-dalej" name="strzalka-w-prawo" size={20} />
  <Icon slot="ikona-wszystkie" name="strzalka-w-prawo" size={18} />
</CardRail>

<style>
  :global(.rail-sec__item--jerozolima) {
    --era: var(--era-jerozolima);
    --era-text: var(--era-jerozolima-text);
  }
  :global(.rail-sec__item--wlochy) {
    --era: var(--era-wlochy);
    --era-text: var(--era-wlochy-text);
  }
  :global(.rail-sec__item--karaiby) {
    --era: var(--era-karaiby);
    --era-text: var(--era-karaiby-text);
  }
  :global(.rail-sec__item--londyn) {
    --era: var(--era-londyn);
    --era-text: var(--era-londyn-text);
  }
  :global(.rail-sec__item--japonia) {
    --era: var(--era-japonia);
    --era-text: var(--era-japonia-text);
  }
</style>
