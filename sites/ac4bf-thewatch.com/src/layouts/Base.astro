---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DescentRail from '../components/DescentRail.astro';
import Grain from '@factory/core/effects/Grain.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link t-button" href="#tresc">Przejdź do treści</a>
    <DescentRail />
    <SiteHeader />
    <main id="tresc">
      <slot />
    </main>
    <SiteFooter />
    <Grain />

    <style is:global>
      /* Skala zejścia zajmuje lewą krawędź — treść ustępuje jej miejsca. */
      @media (min-width: 1200px) {
        body {
          padding-left: var(--rail);
        }
      }

      html.menu-otwarte {
        overflow: hidden;
      }
    </style>
  </body>
</html>
