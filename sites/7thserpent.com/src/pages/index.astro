---
/**
 * Главная (сессия 9, П79): «Трасса пули» — серия по порядку как траектория
 * одной пули. Ритм: первый экран → трасса (Max Payne → Max Payne 2 →
 * пауза-реплика → Max Payne 3 → ремейк) → лента страниц вокруг игр →
 * игры по порядку → каталог → призыв → подвал. Стороны кадра у соседних
 * рядов зеркальны, среда меняется каждые одну-две секции (`band`).
 *
 * Страница — свой шаблон, как главная первого сайта (П32 п. 4): маршрута
 * `[...slug]` у второго сайта ещё нет (пачка 0, бэклог 54 п. 9). У маршрута
 * берутся две вещи: поля SEO и `h1` — из структуры (П24 п. 3), и сверка
 * «`blocks[]` равен напечатанному» — той же конструкцией, что у первого
 * сайта. Разошлись — сборка падает.
 */
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeTrack from '../components/HomeTrack.astro';
import GameRow from '../components/GameRow.astro';
import NightQuote from '../components/NightQuote.astro';
import ReadNext from '../components/ReadNext.astro';
import GamesInOrder from '../components/GamesInOrder.astro';
import SiteIndex from '../components/SiteIndex.astro';
import StartBand from '../components/StartBand.astro';
import slownik from '@factory/core/structure/blocks.json';
import { getPage } from '../lib/structure';
import { rows, readNext, inOrder, catalog, kluczeGlownej } from '../data/home';

const strona = getPage('/');
const [mp1, mp2, mp3, remake] = rows;

const gotowy = (imie: string) =>
  Boolean((slownik as { блоки: Record<string, { реализован?: boolean }> }).блоки[imie]?.реализован);
const klucz = (b: { block: string; role?: string }) => (b.role ? `${b.block}#${b.role}` : b.block);
const wystapienia = strona.blocks as { block: string; role?: string }[];
const pominiete = wystapienia.filter((b) => !gotowy(b.block)).map(klucz);
const doZrobienia = wystapienia.filter((b) => gotowy(b.block)).map(klucz);
if (pominiete.length) {
  console.log(`  ${strona.url} — блоки объявлены, но в ядре не реализованы: ${pominiete.join(', ')}`);
}

/**
 * ЕСТЬ ЛИ ЧЕМ НАПОЛНИТЬ БЛОК — по предикату на имя, из данных главной
 * (`src/data/home.ts`). Те же предикаты стоят в условиях печати ниже:
 * список и печать считаются из одного источника и разойтись не могут.
 */
const maTresc: Record<string, (role?: string) => boolean> = {
  'hero-key-art': () => true,
  'story-row': () => rows.length > 0,
  // Пауза стоит на трассе между рядами (печатается внутри `HomeTrack`), поэтому
  // без напечатанных рядов её негде напечатать — и сверка обязана это увидеть
  // («судью судят», сессия 9, находка C2). Условие — то же, по которому
  // печатается `story-row` (объявлен, реализован в ядре, есть ряды), а не одно
  // объявление: раунд 2 (F2) показал, что при `story-row` «не реализован»
  // сверка проходила, а цитаты на странице не было.
  'band-quote': () =>
    wystapienia.some((b) => b.block === 'story-row') && gotowy('story-row') && maTresc['story-row'](),
  'card-rail': () => readNext.cards.length > 0,
  'link-list': (role) => role === 'games-in-order' && inOrder.items.length > 0,
  'link-columns': () => catalog.groups.length > 0,
  'cta-band': () => true,
};

/** Порядок печати ЭТОГО шаблона — первые вхождения блоков в разметке ниже.
 *  `story-row` печатается четыре раза, разрезанный паузой; как блок
 *  считается один раз, на месте первого ряда.
 *
 *  ПРЕДЕЛЫ СВЕРКИ (раунды 2–3 «судью судят», F3 и R3-S5): сравниваются
 *  последовательности ключей, а шаблон печатает каждый блок один раз по
 *  `est()`. Повтор блока в `blocks[]` проходит и печатается один раз, если
 *  между вхождениями нет блоков, реализованных в ядре (подряд или через
 *  нереализованные); роль у блока, кроме `link-list`, здесь не читается —
 *  `est()` сравнивает по началу ключа, печатается то же содержимое. У главной
 *  первого сайта печать идёт по точному ключу, и роль там выбрасывает блок
 *  со страницы при зелёной сверке (бэклог 58); у маршрута `[...slug]` первого
 *  сайта роли сторожит отдельная проверка. Здесь её нет. */
const PORYADOK = ['hero-key-art', 'story-row', 'band-quote', 'card-rail', 'link-list', 'link-columns', 'cta-band'];

const pechat = PORYADOK.flatMap((imie) =>
  wystapienia
    .filter((b) => b.block === imie && gotowy(imie) && (maTresc[imie]?.(b.role) ?? false))
    .map(klucz)
);

if (doZrobienia.join(',') !== pechat.join(',')) {
  const brakujace = doZrobienia.filter((k) => !pechat.includes(k));
  throw new Error(
    `blocks[] и печать разошлись на ${strona.url}.\n` +
      `  структура объявляет и ядро умеет: ${doZrobienia.join(', ') || '—'}\n` +
      `  шаблон напечатает:                 ${pechat.join(', ') || '—'}\n` +
      (brakujace.length
        ? `  без содержания или без места в PORYADOK: ${brakujace.join(', ')}\n`
        : '  разошёлся только порядок\n') +
      'Поправьте данные, шаблон или структуру — но не оставляйте расхождения.'
  );
}

const est = (imie: string) => pechat.some((k) => k === imie || k.startsWith(`${imie}#`));
---

<Base title={strona.title} description={strona.description} klucze={kluczeGlownej}>
  {est('hero-key-art') && <HomeHero h1={strona.h1} />}

  {
    est('story-row') && (
      <HomeTrack>
        <GameRow row={mp1} flip={false} band={false} />
        <GameRow row={mp2} flip={true} band={true} />
        {est('band-quote') && <NightQuote />}
        <GameRow row={mp3} flip={false} band={false} />
        <GameRow row={remake} flip={false} band={true} />
      </HomeTrack>
    )
  }

  {est('card-rail') && <ReadNext />}

  {
    est('link-list#games-in-order') && (
      <div class="band">
        <GamesInOrder />
      </div>
    )
  }

  {est('link-columns') && <SiteIndex />}
  {est('cta-band') && <StartBand />}
</Base>

<style>
  /* Координата трассы — одна на первый экран (выход линии у полосы отметок,
     `HomeHero.astro`) и на ряды (`HomeTrack.astro`, `GameRow.astro`), поэтому
     живёт на общем предке — `<main>` главной. Считается от ширины `<main>`
     (`100cqw`): начало линии в герое позиционируется от колонки контейнера,
     ряды — от края страницы, и общая мера нужна обоим. Там, где есть поле
     страницы (от 1360px), — середина между краем страницы и краем
     контейнера; уже — середина поля колонки (`--gutter`). Переменная
     раскладки главной, не токен темы.
     Не `100vw`: в окно входит полоса прокрутки, а колонка контейнера
     центрируется в ширине без неё — при классической полосе (Windows)
     начало трассы в герое уходило от линии рядов на половину ширины полосы
     («судью судят», сессия 9, раунд 2, R2-S1). `<main>` — контейнер
     по ширине: `100cqw` его потомков — ширина страницы без полосы. */
  :global(#content) {
    container-type: inline-size;
    --trasa-x: calc(var(--gutter) / 2);
  }

  @media (min-width: 1360px) {
    :global(#content) {
      --trasa-x: calc((100cqw - var(--container)) / 4);
    }
  }
</style>
