    "accept:css": "node ../../core/accept/css-triples.mjs",
    "accept:pixels": "node ../../core/accept/pixels.mjs",
    "accept:html": "node ../../core/accept/html-diff.mjs",
    "accept:frames": "node ../../core/accept/frames.mjs",
    "accept:szum": "node ../../core/accept/szum.mjs",
    "corpus": "node tools/fetch-corpus.mjs",
    "corpus:check": "node tools/fetch-corpus.mjs --dry-run",
    "corpus:report": "node tools/fetch-corpus.mjs --report",
    "recon": "node tools/recon-s0.mjs",
    "recon:check": "node tools/recon-s0.mjs --dry-run",
