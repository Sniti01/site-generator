---
/**
 * `smart-image` — кадр: изображение, подпись об источнике поверх него
 * и место под запасную графику, когда изображения нет.
 *
 * ДОГОВОР ПРОПСОВЫЙ — решение П4 владельца от 2026-09-07. Сайт передаёт
 * готовые `ImageMetadata`, ядро принимает. Ядро не знает ни раскладки папок
 * сайта, ни имён его файлов, ни того, откуда картинка взялась: разрешатель
 * источника — посайтовый помощник, он же выбирает `quality` и модификаторы
 * оболочки. Ядро отвечает за оболочку `.foto`, за вызов `astro:assets`
 * и за два именованных места.
 *
 * ПОЧЕМУ НЕ ГЛОБ В САМОМ ЯДРЕ. Корнеотносительный `'/src/assets/…'` из `core/`
 * работает — измерено, запись от 2026-09-07, — но это второй договор на ассеты
 * рядом с пропсовым, и отказывает он молча: неверный путь даёт пустой объект
 * без ошибки и без предупреждения. Двух договоров на ассеты в одном ядре
 * не держим; глоб живёт посайтовым помощником, где ошибка пути видна на самом
 * сайте, а гейт `check-assets` стережёт его данные.
 *
 * ПОДПИСЬ — МЕСТО, А НЕ ДАННЫЕ. Форм у подписи столько же, сколько источников
 * у сайта: у материала издателя это одна ссылка, у фотографии — автор
 * и лицензия с `rel="license"`. Ядро рисует `<p class="foto__credit">`,
 * потому что правило `.foto__credit a` из шасси выбирает его содержимое,
 * и оставляет внутри место. Пусто — нет и `<p>`.
 *
 * ЗАПАС — ТОЖЕ МЕСТО, и это третий уровень разрешателя (`REUSE.md` §1.4).
 * Нет `src` — рисуется слот `zapas` целиком, без оболочки `.foto`: запасная
 * графика приносит свою. Ветка не косметическая, на ней держится обещание
 * фабрики — свежий клон собирается и выглядит законченным до первого запуска
 * скриптов скачивания.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Метаданные, уже разрешённые сайтом. Нет источника — рисуется `zapas`. */
  src?: ImageMetadata;
  alt: string;
  sizes: string;
  widths: number[];
  /** Компромисс веса и качества выбирает сайт: кадр во весь экран и плитка
   *  в ленте стоят разного. Не передан — решает Astro. */
  quality?: number;
  loading?: 'lazy' | 'eager';
  /** Модификаторы оболочки поверх `.foto` — например `foto--gra`. */
  class?: string;
}

const { src, alt, sizes, widths, quality, loading = 'lazy', class: className } = Astro.props;

// Спрашиваем не «подан ли слот», а «есть ли в нём что-нибудь». `Astro.slots.has`
// отвечает на первый вопрос: место подписи занимает у сайта выражение вида
// `{credit && meta && (…)}`, и при ложном условии слот всё равно считается
// поданным. Измерено при выносе: десять пустых `<p class="foto__credit">`
// в `index.html` — с фоном и отступами из шасси, то есть видимых.
const podpis = Astro.slots.has('podpis') ? await Astro.slots.render('podpis') : '';
---

{
  src ? (
    <div class:list={['foto', className]}>
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        quality={quality}
      />
      {podpis.trim() && <p class="foto__credit t-micro" set:html={podpis} />}
    </div>
  ) : (
    <slot name="zapas" />
  )
}
