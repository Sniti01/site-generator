---
/**
 * `band-quote` — pauza między ciężkimi warstwami.
 *
 * Mechanizm, nie treść. Rdzeń trzyma zmianę środowiska: inne tło z poświatą
 * akcentu, kreski nad i pod, wyśrodkowanie i węższa miara niż wszystko
 * dookoła. Ornament, cytat i akapit przychodzą z witryny.
 *
 * Ornament idzie slotem, a reguła `.creed__ornament` zostaje przy witrynie —
 * z tego samego powodu co `.cta__art` przy `CtaBand`: `data-astro-cid-*`
 * wiąże regułę z elementem po skrócie, więc art i jego reguła muszą mieszkać
 * w jednym komponencie, inaczej art gubi rozmiar i kolor po cichu.
 *
 * Cytat i akapit też są slotami, nie propsami — inaczej niż w `CtaBand`.
 * Powód jest konkretny: cytat niesie własne `<br />`, a akapit jest łamany
 * w źródle witryny. Jedno i drugie to autorskie formatowanie, a nie dana;
 * przez propsa-string nie przechodzi bez zmiany bajtów w `index.html`.
 * Krótkie jednowierszowe napisy nadal jadą propsami — tak jest w `CtaBand`.
 */
interface Props {
  /** Id nagłówka; wiąże `aria-labelledby` sekcji z samym cytatem. */
  id?: string;
}

const { id = 'creed-tytul' } = Astro.props;
---

<section class="creed" aria-labelledby={id}>
  <slot name="ornament" />

  <div class="creed__inner container">
    <h2 class="creed__quote t-headline" id={id}><slot name="cytat" /></h2>
    <p class="creed__body t-lead"><slot name="tresc" /></p>
  </div>
</section>

<style>
  .creed {
    position: relative;
    padding-block: var(--space-3xl);
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 62%),
      var(--bg-band);
    border-block: 1px solid var(--hairline);
    text-align: center;
  }

  .creed__quote {
    color: var(--ink);
  }

  .creed__body {
    max-width: 56ch;
    margin: var(--space-md) auto 0;
    color: var(--ink-muted);
  }
</style>
