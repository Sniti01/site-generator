---
/**
 * `link-list` — список настоящих ссылок с припиской справа и одной ссылкой
 * «все» под ним.
 *
 * Механизм, не содержание. Ядро держит строку списка целиком: волосяные линии
 * между строками, раскладку «заголовок слева, приписка справа», сдвиг строки
 * при наведении и обрушение строки в столбик на узком экране. Адреса, надписи
 * и приписки приходят с витрины записями, иконки — местами.
 *
 * ЗАПИСИ ПРИХОДЯТ ДАННЫМИ, а не разметкой. Слот содержимое не размножает,
 * а пунктов в списке сколько угодно — поэтому `items` пропс, а не место.
 * Тот же довод, что у `CardRail` (`docs/REUSE.md` §1.1, сноска ⁶).
 *
 * ИКОНКА ПРИПИСКИ — ОДНО МЕСТО НА ВСЕ СТРОКИ. Она одинакова во всех строках,
 * а слот в цикле не размножается: место рендерится один раз и повторяется
 * в каждой строке. Набор имён иконок — словарь витрины, и в договор блока он
 * не въезжает. Нет места — нет и иконки.
 *
 * ПРИПИСКА — СТРОКА, А НЕ ЧИСЛО. Слово-единица («min», «cz.», год) принадлежит
 * языку витрины, и не у всякого списка приписка означает время чтения.
 *
 * ЧЕГО ЗДЕСЬ НЕТ НАМЕРЕННО: заголовка, рамки `<section>`, счётчика у пункта,
 * второго уровня вложенности. Ни у одного из них в Фазе 3 нет потребителя,
 * а второй вариант подачи придумывается не здесь (`REUSE` §1.1).
 */
interface Pozycja {
  /** Адрес ссылки. */
  href: string;
  /** Надпись ссылки. */
  title: string;
  /** Приписка справа, уже собранная витриной. Нет приписки — нет и `<span>`. */
  meta?: string;
}

interface Props {
  /** Записи списка. */
  items: Pozycja[];
  /** Заголовок. Есть — блок печатает свою секцию; нет — остаётся голым `<ul>`. */
  title?: string;
  /** Id заголовка; вяжет `aria-labelledby` секции с самим заголовком. */
  titleId?: string;
  /** Адрес ссылки «все»; нет адреса — нет и всей нижней ссылки. */
  allHref?: string;
  /** Надпись ссылки «все». */
  allLabel?: string;
}

const { items, allHref, allLabel, title, titleId } = Astro.props;

// Рамка и заголовок — НЕОБЯЗАТЕЛЬНЫЕ, по прецеденту `CardRail`. Без заголовка
// блок остаётся голым `<ul>`, каким он и жил внутри `story-row` на главной,
// и вид главной от этой правки не меняется ни на пиксель — это и есть её
// судья. С заголовком он становится секцией: имя `link-list` объявлено
// в `blocks[]` двадцати семи страницам с `related` (вариант «б» владельца),
// а секция без рамки и заголовка собиралась бы маршрутом — ровно тот дефект
// «чужой секции», из-за которого правка и затевалась.
const самостоятельный = Boolean(title);

// СПИСОК УДВОЕН В ДВУХ ВЕТКАХ НАМЕРЕННО, и обе прежние попытки обойтись
// без удвоения измерены и отброшены, 2026-09-10:
//
//   1. Динамический тег (`section` против `Fragment`) ОТОРВАЛ от компонента
//      весь его `<style>`: скрут исчез с семидесяти мест главной, правил
//      в собранном листе стало 335 → 327. Astro скоупит по элементам
//      шаблона, и динамический корень скоупить нечем.
//   2. Одна обёртка `<div>` с условными классами вернула стили, но добавила
//      лишний узел внутрь `story-row` — и главная разошлась на 100 561
//      субпикселе при максимуме 13: схлопывание полей изменилось,
//      и слой уехал на доли пикселя.
//
// Отсюда две ветки со статическими корнями. Цена — четырнадцать строк
// в двух местах; если правите список, правьте оба.

// Спрашиваем не «подан ли слот», а «есть ли в нём что-нибудь»: у витрины место
// иконки может занимать выражение с ложным условием, и слот всё равно считается
// поданным. Идиома и её довод — `SmartImage`, запись DECISIONS от 2026-09-07.
// `.trim()` обязателен: отрендеренное место идёт вплотную к приписке, и лишний
// пробел был бы расхождением в собранной странице.
const ikona = Astro.slots.has('ikona-dopisku')
  ? (await Astro.slots.render('ikona-dopisku')).trim()
  : '';
---

{
  самостоятельный ? (
    <section class="link-list section--light container" aria-labelledby={titleId}>
      <h2 class="link-list__title t-headline" id={titleId}>{title}</h2>
    <ul class="layer__guides">
      {
        items.map((item) => (
          <li class="layer__guide">
            <a class="layer__guide-link" href={item.href}>
              <span class="layer__guide-title t-title">{item.title}</span>
              {item.meta && (
                <span class="layer__guide-time t-caption tabular">{ikona && <Fragment set:html={ikona} />}{item.meta}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    {allHref && <a class="btn-link t-button" href={allHref}>{allLabel}<slot name="ikona-wszystkie" /></a>}
    </section>
  ) : (
    <Fragment>
    <ul class="layer__guides">
      {
        items.map((item) => (
          <li class="layer__guide">
            <a class="layer__guide-link" href={item.href}>
              <span class="layer__guide-title t-title">{item.title}</span>
              {item.meta && (
                <span class="layer__guide-time t-caption tabular">{ikona && <Fragment set:html={ikona} />}{item.meta}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    {allHref && <a class="btn-link t-button" href={allHref}>{allLabel}<slot name="ikona-wszystkie" /></a>}
    </Fragment>
  )
}


<style>
  /* Рамка появляется только у самостоятельного блока; внутри `story-row`
     этих правил не на чем сработать — там нет ни `.link-list`, ни заголовка.
     Отбивку самостоятельной ветки задаёт `.section--light`
     (`core/styles/layout.css`); голая ветка внутри ряда её не носит. */
  .link-list__title {
    margin: 0 0 var(--space-xs);
    color: var(--ink);
  }

  .layer__guides {
    margin: var(--space-xl) 0 var(--space-md);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .layer__guide {
    border-bottom: 1px solid var(--hairline);
  }

  .layer__guide-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    text-decoration: none;
    transition: transform 180ms var(--ease-out);
  }

  .layer__guide-link:hover {
    transform: translateX(var(--space-2xs));
  }

  .layer__guide-title {
    color: var(--ink);
    text-wrap: pretty;
    transition: color 180ms var(--ease-out);
  }

  .layer__guide-link:hover .layer__guide-title {
    color: var(--era-text);
  }

  .layer__guide-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    flex: none;
    color: var(--ink-muted);
  }

  @media (max-width: 560px) {
    .layer__guide-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3xs);
    }
  }
</style>
