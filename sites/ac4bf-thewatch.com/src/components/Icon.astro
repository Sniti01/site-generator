---
/**
 * Ikona witryny. Plik istnieje po to, żeby wywołania zostały przy samym
 * `name`, a nazwa była sprawdzana typem `IconName`, nie dowolnym stringiem:
 * rdzeń przyjmuje słownik, więc na jego granicy typ nazw znika.
 */
import CoreIcon from '@factory/core/primitives/Icon.astro';
import { iconPaths, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
---

<CoreIcon name={name} paths={iconPaths} size={size} class={className} />
